{{#each groups}}<article class="op-card op-item-group"><header><h3>{{label}}</h3>{{#if @root.editable}}<button type="button" data-action="createItem" data-type="{{type}}">Adicionar</button>{{/if}}</header><ul>{{#each items}}<li><img class="op-item-icon" src="{{img}}" alt=""><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button>{{#if grade}}<span>{{grade}}º grau</span>{{/if}}{{#if homebrew}}<span class="op-badge">Homebrew</span>{{/if}}{{#if @root.editable}}<button type="button" data-action="toggleEquipment" data-item-id="{{id}}">{{#if equipped}}Equipado{{else}}Equipar{{/if}}</button><button type="button" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remover {{name}}">×</button>{{/if}}</li>{{else}}<li class="op-hint">Nenhum conteúdo registrado.</li>{{/each}}</ul></article>{{/each}}