{{#each groups}}
<article class="op-card op-item-group items-section card" data-op-item-list="{{type}}"><header><h3><button type="button" class="unbutton" data-list-collapse aria-expanded="true" aria-label="Recolher ou expandir {{label}}"><i class="fa-solid fa-caret-down" aria-hidden="true"></i> {{label}}</button></h3>{{#if @root.canUse}}{{#if canAddLibrary}}<button type="button" data-action="addLibraryContent" data-type="{{type}}">Adicionar</button>{{/if}}{{/if}}{{#if @root.editable}}{{#if canCreate}}<button type="button" data-action="createItem" data-type="{{type}}">Criar</button>{{/if}}{{/if}}</header><div data-list-content><div class="op-list-controls"><label class="op-list-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-op-list-control="search" aria-label="Buscar em {{label}}" placeholder="Buscar…"></label><select data-op-list-control="filter" aria-label="Filtrar {{label}}"><option value="all">Todos</option><option value="favorites">Favoritos</option><option value="equipped">Equipados</option>{{#if allowHomebrewFilter}}<option value="homebrew">Homebrew</option>{{/if}}</select><select data-op-list-control="sort" aria-label="Ordenar {{label}}"><option value="original">Ordem da ficha</option><option value="name">Nome</option><option value="quantity">Quantidade</option></select><span data-list-status aria-live="polite"></span></div><ul>
{{#each items}}<li class="item-row" data-op-item-row data-item-name="{{name}}" data-favorite="{{favorite}}" data-equipped="{{equipped}}" data-homebrew="{{homebrew}}" data-quantity="{{quantity}}"><img class="op-item-icon" src="{{img}}" alt=""><div class="op-item-title"><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button><small>{{#if grade}}{{grade}}º grau · {{/if}}{{activation}}{{#if trainingProgress}} · {{trainingProgress}}{{/if}}{{#if canUse}} · <span title="{{costExplanation}}" tabindex="0">{{cost}} PP</span>{{/if}}{{#if isEquipment}} · {{quantity}} un. · {{weight}} kg/un.{{/if}}</small>{{#if trainingSummary}}<small>{{trainingSummary}}</small>{{/if}}{{#if usesSummary}}<small>{{usesSummary}}</small>{{/if}}{{#if requirements}}<small class="op-item-requirements">Requisitos: {{requirements}}</small>{{/if}}</div>
{{#if homebrew}}<span class="op-badge">Homebrew</span>{{/if}}{{#if @root.canUse}}{{#if canUse}}<button type="button" data-action="useItem" data-item-id="{{id}}">Usar</button>{{/if}}{{/if}}{{#if @root.canUse}}<button type="button" class="op-favorite-control" data-action="toggleFavorite" data-item-id="{{id}}" aria-label="Alternar favorito {{name}}" aria-pressed="{{favorite}}">{{#if favorite}}★{{else}}☆{{/if}}</button>{{#if isEquipment}}<button type="button" class="op-equip-control" data-action="toggleEquipment" data-item-id="{{id}}" aria-label="{{#if equipped}}Desequipar{{else}}Equipar{{/if}} {{name}}" aria-pressed="{{equipped}}"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></button>{{/if}}{{/if}}{{#if @root.editable}}{{#if inTraining}}<button type="button" data-action="recordTrainingDay" data-item-id="{{id}}">Registrar dia</button>{{/if}}{{#if consumable}}<button type="button" data-action="consumeEquipment" data-item-id="{{id}}">Consumir 1</button>{{/if}}<button type="button" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remover {{name}}">×</button>{{/if}}</li>
{{else}}<li class="op-hint">Nenhum conteúdo registrado.</li>{{/each}}</ul><p class="op-hint" data-list-no-results hidden>Nenhum item corresponde à busca.</p></div></article>{{/each}}