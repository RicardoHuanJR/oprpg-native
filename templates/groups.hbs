{{#each groups}}
<article class="op-card op-item-group"><header><h3>{{label}}</h3>{{#if @root.editable}}<button type="button" data-action="createItem" data-type="{{type}}">Adicionar</button>{{/if}}</header><ul>
{{#each items}}<li><img class="op-item-icon" src="{{img}}" alt=""><div class="op-item-title"><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button><small>{{#if grade}}{{grade}}º grau · {{/if}}{{activation}}{{#if trainingProgress}} · {{trainingProgress}}{{/if}}{{#if canUse}} · {{cost}} PP{{/if}}{{#if isEquipment}} · {{quantity}} un. · {{weight}} kg/un.{{/if}}</small></div>
{{#if homebrew}}<span class="op-badge">Homebrew</span>{{/if}}{{#if @root.canUse}}{{#if canUse}}<button type="button" data-action="useItem" data-item-id="{{id}}">Usar</button>{{/if}}{{/if}}{{#if @root.editable}}{{#if inTraining}}<button type="button" data-action="recordTrainingDay" data-item-id="{{id}}">Registrar dia</button>{{/if}}<button type="button" data-action="toggleFavorite" data-item-id="{{id}}" aria-label="Alternar favorito {{name}}">☆</button>{{#if consumable}}<button type="button" data-action="consumeEquipment" data-item-id="{{id}}">Consumir 1</button>{{/if}}{{#if isEquipment}}<button type="button" data-action="toggleEquipment" data-item-id="{{id}}">{{#if equipped}}Equipado{{else}}Equipar{{/if}}</button>{{/if}}<button type="button" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remover {{name}}">×</button>{{/if}}</li>
{{else}}<li class="op-hint">Nenhum conteúdo registrado.</li>{{/each}}</ul></article>{{/each}}