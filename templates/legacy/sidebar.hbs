<div class="sidebar"><div class="card">
  <button type="button" class="sidebar-collapser collapser card-tab vertical unbutton" data-action="toggleSidebar" aria-label="Recolher ou expandir lateral"><i class="fa-solid fa-caret-left"></i></button>
  <div class="portrait {{#if tokenPortrait}}token{{/if}}" style="--op-portrait-fit:{{portraitFit}}"><button type="button" class="slide-toggle roboto-upper" data-action="togglePortrait">{{#if tokenPortrait}}MOSTRAR RETRATO{{else}}MOSTRAR TOKEN{{/if}}</button><img src="{{portraitImage}}" alt="Retrato de {{actor.name}}" {{#if editable}}data-action="editImage" data-edit="{{#if tokenPortrait}}prototypeToken.texture.src{{else}}img{{/if}}"{{/if}}>{{#if editable}}<button type="button" class="op-edit-portrait unbutton" data-action="editImage" data-edit="{{#if tokenPortrait}}prototypeToken.texture.src{{else}}img{{/if}}" aria-label="Editar {{#if tokenPortrait}}token{{else}}retrato{{/if}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{/if}}</div>
  <div class="stats"><div class="top"><div class="pips">{{#each exhaustionLeft}}<button type="button" class="pip {{#if filled}}filled{{/if}}" data-action="setExhaustion" data-level="{{level}}" aria-label="Exaustão {{level}}" aria-pressed="{{filled}}"></button>{{/each}}</div><div class="ac-badge badge"><label><span class="sr-only">Classe de Resistência</span><span class="op-resistance-label" aria-hidden="true">CR{{#if editable}} base{{/if}}</span><input type="number" name="system.defense.rating" value="{{#if editable}}{{defenseBaseInput}}{{else}}{{system.defense.rating}}{{/if}}" title="{{#if editable}}CR base, sem os benefícios. Total atual: {{system.defense.rating}}{{else}}Classe de Resistência total{{/if}}" {{#unless editable}}disabled{{/unless}}></label>{{#if editable}}<small class="op-cr-total">Total {{system.defense.rating}}</small>{{/if}}</div><div class="pips">{{#each exhaustionRight}}<button type="button" class="pip {{#if filled}}filled{{/if}}" data-action="setExhaustion" data-level="{{level}}" aria-label="Exaustão {{level}}" aria-pressed="{{filled}}"></button>{{/each}}</div></div>
  <div class="lozenges op-stat-strip"><button type="button" class="lozenge unbutton" data-action="rollInitiative" aria-label="Rolar iniciativa"><i class="fa-solid fa-bolt" aria-hidden="true"></i><span class="value">{{initiativeBonus}}</span><span class="label roboto-condensed-upper">INICIATIVA</span></button><div class="lozenge proficiency"><i class="fa-solid fa-star" aria-hidden="true"></i><span class="value">+{{system.proficiency.bonus}}</span><span class="label roboto-condensed-upper">PROFICIÊNCIA</span></div><button type="button" class="lozenge movement unbutton" data-action="configureMovement" aria-label="Configurar deslocamento" title="{{movementExplanation}}"><i class="fa-solid fa-shoe-prints" aria-hidden="true"></i><span class="value">{{system.effectiveMovement}} <small>m</small></span><span class="label roboto-condensed-upper">MOVIMENTO</span></button></div>
  {{#if movementInCombat}}<button type="button" class="op-movement-counter" data-action="openMovementPanel" title="Registrar ou corrigir o gasto"><span>Movimento: {{movementTurn.spent}} / {{movementTurn.maximum}} m</span><small>{{movementTurn.remaining}} m restantes{{#if movementTurn.exceeded}} · acima do limite{{/if}}</small></button>{{/if}}<div class="meter-group"><div class="label roboto-condensed-upper"><span>PONTOS DE VIDA</span><button type="button" class="config-button unbutton" data-action="configureResources" aria-label="Configurar recursos"><i class="fa-solid fa-gear"></i></button></div><div class="meter sectioned hit-points"><div class="progress hit-points" style="--bar-percentage:{{healthPercent}}%"></div><label class="label"><input type="number" name="system.vitality.value" value="{{system.vitality.value}}" min="0" aria-label="PV atuais" {{#unless editable}}disabled{{/unless}}><span title="{{hpExplanation}}" tabindex="0">/ {{system.vitality.max}}</span></label>{{#if system.vitality.temporary}}<span class="op-temp-hp" title="Pontos de Vida temporários">TMP {{system.vitality.temporary}}</span>{{/if}}</div>{{#if system.vitality.negative}}<small>PV negativos {{system.vitality.negative}}</small>{{/if}}</div>
  <div class="meter-group"><div class="label roboto-condensed-upper">PONTOS DE PODER</div><div class="meter sectioned power"><div class="progress" style="--bar-percentage:{{powerPercent}}%"></div><label class="label"><input type="number" min="0" name="system.power.value" value="{{system.power.value}}" aria-label="PP atuais" {{#unless editable}}disabled{{/unless}}><span title="{{powerExplanation}}" tabindex="0">/ {{system.power.max}}</span></label></div></div>
  <div class="meter-group"><div class="label roboto-condensed-upper">DADOS DE VIDA</div><div class="meter sectioned dice"><div class="progress" style="--bar-percentage:{{hitDicePercent}}%"></div><label class="label"><span>{{system.hitDice.available}} / {{system.hitDice.max}}</span></label></div>{{#each system.hitDice.pools}}<small>d{{faces}} · {{available}}/{{max}}</small>{{/each}}</div>
  </div><div class="favorites"><h3 class="roboto-upper"><i class="fa-solid fa-bookmark" aria-hidden="true"></i> FAVORITOS</h3><ul>{{#each favorites}}<li><button type="button" class="unbutton" data-action="editItem" data-item-id="{{id}}">{{name}}</button>{{#if canUse}}<button type="button" data-action="useItem" data-item-id="{{id}}">Usar</button>{{/if}}</li>{{else}}<li class="empty">Marque um item como favorito</li>{{/each}}</ul></div>
</div></div>
