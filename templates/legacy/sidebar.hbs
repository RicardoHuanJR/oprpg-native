<div class="sidebar"><div class="card">
  <button type="button" class="sidebar-collapser collapser card-tab vertical unbutton" data-action="toggleSidebar" aria-label="Recolher ou expandir lateral"><i class="fa-solid fa-caret-left"></i></button>
  <div class="portrait"><button type="button" class="slide-toggle roboto-upper" data-action="togglePortrait">{{#if tokenPortrait}}MOSTRAR RETRATO{{else}}MOSTRAR TOKEN{{/if}}</button><img src="{{portraitImage}}" alt="Retrato de {{actor.name}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}></div>
  <div class="stats"><div class="top"><div class="pips">{{#each exhaustionLeft}}<button type="button" class="pip {{#if filled}}filled{{/if}}" data-action="setExhaustion" data-level="{{level}}" aria-label="Exaustão {{level}}" aria-pressed="{{filled}}"></button>{{/each}}</div><div class="ac-badge badge"><label><span class="sr-only">Classe de Resistência</span><input type="number" name="system.defense.rating" value="{{system.defense.rating}}" {{#unless editable}}disabled{{/unless}}></label></div><div class="pips">{{#each exhaustionRight}}<button type="button" class="pip {{#if filled}}filled{{/if}}" data-action="setExhaustion" data-level="{{level}}" aria-label="Exaustão {{level}}" aria-pressed="{{filled}}"></button>{{/each}}</div></div>
  <div class="lozenges"><button type="button" class="lozenge unbutton" data-action="rollAttribute" data-attribute="dexterity"><span class="value">{{initiativeBonus}}</span><span class="label roboto-condensed-upper">INICIATIVA</span></button><div class="lozenge"><span class="value">{{system.effectiveMovement}} m</span><span class="label roboto-condensed-upper">MOVIMENTO</span></div><div class="lozenge"><span class="value">+{{system.proficiency.bonus}}</span><span class="label roboto-condensed-upper">PROFICIÊNCIA</span></div></div>
  <div class="meter-group"><div class="label roboto-condensed-upper"><span>PONTOS DE VIDA</span><button type="button" class="config-button unbutton" data-action="configureResources" aria-label="Configurar recursos"><i class="fa-solid fa-gear"></i></button></div><div class="meter sectioned hit-points"><div class="progress hit-points" style="--bar-percentage:{{healthPercent}}%"></div><label class="label"><input type="number" name="system.vitality.value" value="{{system.vitality.value}}" min="0" aria-label="PV atuais" {{#unless editable}}disabled{{/unless}}><span>/ {{system.vitality.max}}</span></label></div><small>Temporários {{system.vitality.temporary}} · Negativos {{system.vitality.negative}}</small><div class="op-buttons"><button type="button" data-action="damage">Dano</button><button type="button" data-action="heal">Cura</button><button type="button" data-action="temporary">Temporários</button></div></div>
  <div class="meter-group"><div class="label roboto-condensed-upper">PONTOS DE PODER</div><div class="meter sectioned power"><div class="progress" style="--bar-percentage:{{powerPercent}}%"></div><label class="label"><input type="number" min="0" name="system.power.value" value="{{system.power.value}}" aria-label="PP atuais" {{#unless editable}}disabled{{/unless}}><span>/ {{system.power.max}}</span></label></div></div>
  <div class="meter-group"><div class="label roboto-condensed-upper">DADOS DE VIDA</div><div class="meter sectioned dice"><label class="label"><span>{{system.hitDice.available}} / {{system.hitDice.max}}</span><button type="button" class="unbutton" data-action="hitDie" aria-label="Gastar Dado de Vida"><i class="fa-solid fa-dice-d20"></i></button></label></div>{{#each system.hitDice.pools}}<small>d{{faces}} · {{available}}/{{max}}</small>{{/each}}</div>
  </div><div class="favorites"><h3 class="roboto-upper">FAVORITOS</h3><ul>{{#each favorites}}<li><button type="button" class="unbutton" data-action="editItem" data-item-id="{{id}}">{{name}}</button>{{#if canUse}}<button type="button" data-action="useItem" data-item-id="{{id}}">Usar</button>{{/if}}</li>{{else}}<li class="empty">Marque um item como favorito</li>{{/each}}</ul></div>
</div></div>
