<div class="op-techniques-compact" data-technique-list>
 <div class="op-technique-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-technique-search data-op-list-control placeholder="Buscar técnicas" aria-label="Buscar técnicas"><button type="button" class="unbutton" data-technique-clear aria-label="Limpar busca"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button><button type="button" class="unbutton" data-technique-filters aria-label="Filtrar técnicas"><i class="fa-solid fa-filter" aria-hidden="true"></i></button><button type="button" class="unbutton" data-technique-sort aria-label="Ordenar técnicas por nome" aria-pressed="false"><i class="fa-solid fa-arrow-down-a-z" aria-hidden="true"></i></button></div>
 <select data-technique-filter data-op-list-control aria-label="Filtro de técnicas" hidden><option value="all">Todas as técnicas</option><option value="favorites">Favoritas</option></select>
 {{#each compactTechniqueSections}}<section class="op-technique-section" data-technique-section>
 <header class="op-technique-columns"><h3>{{label}}</h3><span>TEMPO</span><span>ALCANCE</span><span>ALVO</span><span>ROLAR</span><span></span></header>
 <ul>{{#each items}}<li class="op-technique-columns" data-technique-row data-item-name="{{name}}" data-favorite="{{favorite}}">
 <button type="button" class="unbutton op-technique-name" data-action="editItem" data-item-id="{{id}}" title="{{descriptionTitle}}"><img src="{{img}}" alt=""><span>{{name}}</span></button><span class="op-technique-time">{{time}}</span><span>{{range}}</span><span>{{target}}</span><span>{{#if canUse}}{{#if @root.canUse}}<button type="button" class="unbutton op-technique-roll" data-action="useItem" data-item-id="{{id}}" title="{{rollTitle}}" aria-label="Usar {{name}}">{{roll}}</button>{{else}}{{roll}}{{/if}}{{else}}—{{/if}}</span>
 <span class="op-technique-tools">{{#if @root.canUse}}<button type="button" class="unbutton" data-action="configureTechniqueActivity" data-item-id="{{id}}" aria-label="Configurar atividade de {{name}}"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>{{/if}}<button type="button" class="unbutton" data-action="editItem" data-item-id="{{id}}" aria-label="Abrir {{name}}"><i class="fa-solid fa-expand" aria-hidden="true"></i></button><button type="button" class="unbutton" data-technique-menu data-item-id="{{id}}" aria-label="Mais opções de {{name}}"><i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i></button></span>
 </li>{{/each}}</ul></section>{{/each}}
 <p class="op-hint" data-technique-empty>Nenhuma técnica nesta lista.</p>
 {{#if canUse}}<details class="op-technique-add"><summary>Adicionar técnica</summary><div class="op-buttons"><button type="button" data-action="addLibraryContent" data-type="technique">Técnica de combate</button><button type="button" data-action="addLibraryContent" data-type="auxiliary">Auxiliar</button>{{#if editable}}<button type="button" data-action="createItem" data-type="technique">Criar técnica</button><button type="button" data-action="createItem" data-type="auxiliary">Criar auxiliar</button>{{/if}}</div></details>{{/if}}
</div>
