<section class="tab classic-details {{#if active.details}}active{{/if}}" data-op-tab="details" {{#unless active.details}}hidden{{/unless}}>
  <div class="left"><op-filigree-box class="skills"><h3><i class="fa-solid fa-briefcase"></i><span class="roboto-upper">PERÍCIAS</span></h3><ul>{{#each skillGroups}}<li class="skill-separator">{{label}}</li>{{#each skills}}<li data-key="{{id}}"><label class="proficiency-dot" data-factor="{{effectiveMultiplier}}">{{#if grantedProficiency}}<input type="checkbox" checked disabled data-derived="true" title="Proficiência concedida pela origem"{{else}}<input type="checkbox" name="system.skills.{{id}}.proficient" {{#if manualProficient}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}{{/if}} aria-label="Proficiência em {{label}}"></label><span class="ability roboto-upper">{{abbreviation}}</span><button type="button" class="name unbutton" data-action="rollSkill" data-skill="{{id}}" title="{{label}} · Passivo {{passive}}">{{label}}</button><span class="bonus" title="{{calculation}}" tabindex="0" aria-label="Cálculo de {{label}}: {{calculation}}">{{total}}</span>{{#if @root.editable}}<button type="button" class="config-button unbutton" data-action="configureSkill" data-skill="{{id}}" aria-label="Configurar {{label}}"><i class="fa-solid fa-gear"></i></button>{{else}}<span class="passive">{{passive}}</span>{{/if}}</li>{{/each}}{{/each}}</ul></op-filigree-box></div>
  <div class="right"><div class="top flexrow"><op-filigree-box class="saves"><h3><i class="fa-solid fa-shield-heart"></i><span class="roboto-upper">SALVAGUARDAS</span></h3><ul>{{#each attributes}}<li data-attribute="{{id}}"><label class="proficiency-dot">{{#if grantedProficiency}}<input type="checkbox" checked disabled data-derived="true" title="Proficiência concedida pela origem"{{else}}<input type="checkbox" name="system.attributes.{{id}}.saveProficient" {{#if manualProficient}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}{{/if}} aria-label="Proficiência em salvaguarda de {{label}}"></label><button type="button" class="name saving-throw unbutton" data-action="rollAttribute" data-attribute="{{id}}" data-save="true">{{abbreviation}}</button><span class="bonus">{{saveTotal}}</span></li>{{/each}}</ul></op-filigree-box>
  {{#if isCharacter}}<div class="pills-lg"><div class="op-origin-card"><button type="button" class="pill-lg texture race" data-action="{{#if system.identity.species.name}}viewOrigin{{else}}applySpecies{{/if}}" data-kind="species">{{#if speciesReference.img}}<img class="gold-icon" data-book-art="{{speciesReference.art}}" src="{{speciesReference.img}}" alt="">{{else}}<i class="op-origin-symbol fa-solid fa-feather" aria-hidden="true"></i>{{/if}}<span class="name name-stacked"><span class="title">{{#if system.identity.species.name}}{{system.identity.species.name}}{{else}}Escolher espécie{{/if}}</span><small>ESPÉCIE</small></span></button>{{#if editable}}<button type="button" class="config-button unbutton" data-action="openProgression" aria-label="Alterar raça e origens"><i class="fa-solid fa-gear"></i></button>{{/if}}</div><div class="op-origin-card"><button type="button" class="pill-lg texture background" data-action="{{#if system.personal.background}}viewOrigin{{else}}chooseBackground{{/if}}" data-kind="background">{{#if backgroundReference.img}}<img class="gold-icon" data-book-art="{{backgroundReference.art}}" src="{{backgroundReference.img}}" alt="">{{else}}<i class="op-origin-symbol fa-solid fa-scroll" aria-hidden="true"></i>{{/if}}<span class="name name-stacked"><span class="title">{{#if system.personal.background}}{{system.personal.background}}{{else}}Escolher antecedente{{/if}}</span><small>ANTECEDENTE</small></span></button>{{#if editable}}<button type="button" class="config-button unbutton" data-action="openProgression" aria-label="Alterar antecedente e origens"><i class="fa-solid fa-gear"></i></button>{{/if}}</div></div>{{/if}}</div>
  <div class="op-profession-portraits">{{#each professions}}<div class="op-origin-card"><button type="button" class="pill-lg op-profession-portrait" data-action="editItem" data-item-id="{{id}}">{{#if img}}<img class="gold-icon" data-book-art="{{art}}" src="{{img}}" alt="">{{else}}<i class="op-origin-symbol fa-solid fa-{{icon}}" aria-hidden="true"></i>{{/if}}<span class="name name-stacked"><span class="title">{{name}}</span><small>{{#if withoutProfession}}ESCOLHA{{else}}PROFISSÃO{{#if rank}} · {{rank}}{{/if}}{{/if}}</small></span></button><button type="button" class="config-button unbutton" data-action="selectTab" data-tab="professions" aria-label="Abrir profissões"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></button></div>{{else}}<button type="button" class="pill-lg op-profession-portrait" data-action="selectTab" data-tab="professions"><i class="op-origin-symbol fa-solid fa-briefcase" aria-hidden="true"></i><span class="name name-stacked"><span class="title">{{#if legacyProfession}}{{legacyProfession}}{{else}}Escolher profissão{{/if}}</span><small>PROFISSÃO{{#if legacyProfession}} · anotação anterior{{/if}}</small></span></button>{{/each}}</div>
  <div class="op-reference-list"><h3 class="op-reference-heading">Referências do personagem</h3>
    <dl class="op-reference-traits">{{#each traitSummary}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl>
    <div class="op-reference-styles">{{#each styleSummary}}<button type="button" class="unbutton op-reference-style" data-action="openProgression" aria-label="Configurar {{name}} e progressão"><strong>{{name}}</strong><span class="op-reference-level">Nível {{levels}}</span>{{#if primary}}<small>Principal</small>{{/if}}<i class="fa-solid fa-gear" aria-hidden="true"></i></button>{{else}}<button type="button" class="unbutton op-reference-style" data-action="openProgression"><strong>{{#if primaryStyleName}}{{primaryStyleName}}{{else}}Escolher estilo{{/if}}</strong><i class="fa-solid fa-gear" aria-hidden="true"></i></button>{{/each}}</div>

    <div class="op-reference-actions"><button type="button" class="unbutton op-reference-action" data-action="configureReferenceTraits"><i class="fa-solid fa-ruler" aria-hidden="true"></i><span>Tamanho, sentidos e idiomas</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button><button type="button" class="unbutton op-reference-action" data-action="configureMitigation"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>Defesas contra dano</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button></div>
    <details class="op-card op-reference-resources"><summary>Identidade e recursos</summary><label>Experiência<input type="number" min="0" name="system.experience" value="{{system.experience}}" {{#unless editable}}disabled{{/unless}}></label><div class="op-buttons"><button type="button" data-action="configureResources">Configurar PV e PP</button><button type="button" data-action="finishShortRest">Concluir descanso curto</button><button type="button" data-action="finishRest">Concluir descanso longo</button></div></details>
  </div></div>
</section>
