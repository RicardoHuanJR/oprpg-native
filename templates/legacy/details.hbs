<section class="tab classic-details {{#if active.details}}active{{/if}}" data-op-tab="details" {{#unless active.details}}hidden{{/unless}}>
<div class="op-buttons op-mechanics-controls"><button type="button" data-action="openRulesPanel">Operações e regras avançadas</button><button type="button" data-action="openCombatPanel">Ações do turno</button><button type="button" data-action="openMovementPanel">Mover / levantar</button><button type="button" data-action="configureMovement">Deslocamentos</button><button type="button" data-action="configureMitigation">Defesas contra dano</button></div>
  <div class="left"><op-filigree-box class="skills"><h3><i class="fa-solid fa-briefcase"></i><span class="roboto-upper">PERÍCIAS</span></h3><ul>{{#each skillGroups}}<li class="skill-separator">{{label}}</li>{{#each skills}}<li data-key="{{id}}"><label class="proficiency-dot">{{#if grantedProficiency}}<input type="checkbox" checked disabled data-derived="true" title="Proficiência concedida pela origem"{{else}}<input type="checkbox" name="system.skills.{{id}}.proficient" {{#if manualProficient}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}{{/if}} aria-label="Proficiência em {{label}}"></label><span class="ability roboto-upper">{{abbreviation}}</span><button type="button" class="name unbutton" data-action="rollSkill" data-skill="{{id}}">{{label}}</button><span class="bonus">{{total}}</span>{{#if @root.editable}}<button type="button" class="config-button unbutton" data-action="configureSkill" data-skill="{{id}}" aria-label="Configurar {{label}}"><i class="fa-solid fa-gear"></i></button>{{else}}<span class="passive">{{passive}}</span>{{/if}}</li>{{/each}}{{/each}}</ul></op-filigree-box></div>
  <div class="right"><div class="top flexrow"><op-filigree-box class="saves"><h3><i class="fa-solid fa-shield-heart"></i><span class="roboto-upper">SALVAGUARDAS</span></h3><ul>{{#each attributes}}<li data-attribute="{{id}}"><label class="proficiency-dot">{{#if grantedProficiency}}<input type="checkbox" checked disabled data-derived="true" title="Proficiência concedida pela origem"{{else}}<input type="checkbox" name="system.attributes.{{id}}.saveProficient" {{#if manualProficient}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}{{/if}} aria-label="Proficiência em salvaguarda de {{label}}"></label><button type="button" class="name saving-throw unbutton" data-action="rollAttribute" data-attribute="{{id}}" data-save="true">{{abbreviation}}</button><span class="bonus">{{saveTotal}}</span></li>{{/each}}</ul></op-filigree-box>
  {{#if isCharacter}}<div class="pills-lg"><button type="button" class="pill-lg texture race" data-action="applySpecies"><span class="name name-stacked"><span class="title">{{#if system.identity.species.name}}{{system.identity.species.name}}{{else}}Escolher espécie{{/if}}</span><small>ESPÉCIE</small></span></button><button type="button" class="pill-lg texture background" data-action="chooseBackground"><span class="name name-stacked"><span class="title">{{#if system.personal.background}}{{system.personal.background}}{{else}}Escolher antecedente{{/if}}</span><small>ANTECEDENTE</small></span></button></div>{{/if}}</div>
  <div class="pill-lg"><span class="name"><span class="title">{{primaryStyleName}}</span><small>ESTILO DE COMBATE</small></span><button type="button" class="config-button unbutton" data-action="openProgression" aria-label="Estilos e progressão"><i class="fa-solid fa-gear"></i></button></div><div class="pill-lg"><label>PROFISSÃO<input name="system.identity.profession" value="{{system.identity.profession}}" {{#unless editable}}disabled{{/unless}}></label></div>
  <details class="op-card"><summary>Identidade e recursos</summary><label>Experiência<input type="number" min="0" name="system.experience" value="{{system.experience}}" {{#unless editable}}disabled{{/unless}}></label><label>Deslocamento base (m)<input type="number" min="0" step="any" name="system.movement.distance" value="{{movementBaseInput}}" {{#unless editable}}disabled{{/unless}}></label><div class="op-buttons"><button type="button" data-action="configureResources">Configurar PV e PP</button><button type="button" data-action="finishShortRest">Concluir descanso curto</button><button type="button" data-action="finishRest">Concluir descanso longo</button></div></details></div>
</section>
