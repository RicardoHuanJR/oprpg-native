<div class="op-sheet op-ship-original"><header class="sheet-header"><div class="left"><img class="document-image" src="{{actor.img}}" alt="{{actor.name}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}></div><div class="middle"><label class="op-name"><span class="sr-only">Nome</span><input class="document-name" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><p class="document-subtitle">EMBARCAÇÃO · {{system.structure.size}}</p></div></header><nav class="op-item-navigation">{{#each tabs}}<button type="button" data-action="selectTab" data-tab="{{id}}" aria-pressed="{{active}}">{{label}}</button>{{/each}}</nav><fieldset class="op-body"><button type="button" data-action="openRulesPanel">Operações e regras avançadas</button><section data-op-tab="details" {{#unless active.details}}hidden{{/unless}}><div class="op-two-col"><op-filigree-box><h3>ESTRUTURA</h3><div class="op-pair"><label>PV atuais<input type="number" min="0" name="system.vitality.value" value="{{system.vitality.value}}"></label><label>PV máximos<input type="number" min="0" name="system.vitality.max" value="{{system.vitality.max}}"></label><label>CR<input type="number" name="system.defense.rating" value="{{system.defense.rating}}"></label><label>Deslocamento (m)<input type="number" min="0" step="any" name="system.movement.distance" value="{{system.movement.distance}}"></label><label>Tamanho<input name="system.structure.size" value="{{system.structure.size}}"></label><label>Conveses<input type="number" min="0" name="system.structure.decks" value="{{system.structure.decks}}"></label><label>Salas<input type="number" min="0" name="system.structure.rooms" value="{{system.structure.rooms}}"></label><label>Carga<input type="number" min="0" step="any" name="system.structure.cargo" value="{{system.structure.cargo}}"></label></div></op-filigree-box><op-filigree-box><h3>TRIPULAÇÃO</h3><label>A bordo<input type="number" min="0" name="system.crew.current" value="{{system.crew.current}}"></label><label>Tripulação necessária<input type="number" min="0" name="system.crew.required" value="{{system.crew.required}}"></label><label>Capacidade<input type="number" min="0" name="system.crew.capacity" value="{{system.crew.capacity}}"></label><label>Funções e anotações<textarea name="system.crew.notes">{{system.crew.notes}}</textarea></label></op-filigree-box></div><article class="op-card"><h3>Navegação</h3><label>Rumo<input name="system.navigation.heading" value="{{system.navigation.heading}}"></label><label>Clima<input name="system.navigation.weather" value="{{system.navigation.weather}}"></label><label>Notas<textarea name="system.navigation.notes">{{system.navigation.notes}}</textarea></label><label>Descrição<textarea name="system.description">{{system.description}}</textarea></label></article></section><section data-op-tab="inventory" {{#unless active.inventory}}hidden{{/unless}}>{{> "systems/oprpg-native/templates/groups.hbs" groups=inventoryGroups}}</section><section data-op-tab="effects" {{#unless active.effects}}hidden{{/unless}}><article class="op-card"><h3>Efeitos da embarcação</h3><ul>{{#each effects}}<li>{{name}} · {{#if disabled}}desativado{{else}}ativo{{/if}}</li>{{else}}<li>Nenhum efeito registrado.</li>{{/each}}</ul></article></section></fieldset></div>
