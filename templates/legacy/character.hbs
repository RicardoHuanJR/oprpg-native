<div class="legacy-character {{#if sidebarCollapsed}}collapsed{{/if}}">
{{> "systems/oprpg-native/templates/legacy/header.hbs"}}
{{> "systems/oprpg-native/templates/legacy/abilities.hbs"}}
<div class="main-content">{{> "systems/oprpg-native/templates/legacy/sidebar.hbs"}}<div class="legacy-tabs"><nav class="tabs-right" aria-label="Seções da ficha">{{#each tabs}}<button type="button" class="gold-button" data-action="selectTab" data-tab="{{id}}" aria-pressed="{{active}}" title="{{label}}" aria-label="{{label}}"><i class="{{icon}}"></i></button>{{/each}}</nav><div class="tab-body op-body">{{> "systems/oprpg-native/templates/legacy/details.hbs"}}
<section data-op-tab="inventory" aria-label="Inventário" {{#unless active.inventory}}hidden{{/unless}}><button type="button" data-action="browseInventory">Adicionar item do catálogo / da mesa</button>{{#unless isShip}}<article class="op-card"><h3>Dinheiro</h3><label>฿<input type="number" name="system.currency" value="{{system.currency}}" min="0"></label></article>{{/unless}}{{> "systems/oprpg-native/templates/groups.hbs" groups=inventoryGroups}}</section><section data-op-tab="features" aria-label="Características" {{#unless active.features}}hidden{{/unless}}>{{#if isCharacter}}<article class="op-card"><h3>Estilos de combate</h3><div class="op-buttons"><button type="button" data-action="advanceLevel">Avançar nível / Multiestilo</button><button type="button" data-action="openProgression">Origens e histórico</button></div><ul>{{#each styleLevels}}<li>{{name}} · {{levels}} nível(is) · d{{hitDie}}</li>{{else}}<li>Escolha um estilo para iniciar a progressão.</li>{{/each}}</ul></article>{{/if}}{{> "systems/oprpg-native/templates/groups.hbs" groups=featureGroups}}</section><section data-op-tab="techniques" aria-label="Técnicas" {{#unless active.techniques}}hidden{{/unless}}>{{> "systems/oprpg-native/templates/groups.hbs" groups=techniqueGroups}}</section><section data-op-tab="powers" aria-label="Haki e Akuma" {{#unless active.powers}}hidden{{/unless}}><div class="op-two-col"><article class="op-card"><h3>Haki · {{system.haki.stage}}</h3>{{#if isGM}}<button type="button" data-action="awardAmbition">Conceder PA</button><label class="op-checkbox"><input type="checkbox" name="system.haki.awakened" {{#if system.haki.awakened}}checked{{/if}}> Despertar autorizado</label><label class="op-checkbox"><input type="checkbox" name="system.haki.kingAllowed" {{#if system.haki.kingAllowed}}checked{{/if}}> Haki do Rei autorizado</label>{{/if}}<label>PA ociosos<input type="number" name="system.haki.unspent" value="{{system.haki.unspent}}" min="0"></label><label>PA em Armamento<input type="number" name="system.haki.armament" value="{{system.haki.armament}}" min="0"></label><label>PA em Observação<input type="number" name="system.haki.observation" value="{{system.haki.observation}}" min="0"></label><label>PA em Rei<input type="number" name="system.haki.king" value="{{system.haki.king}}" min="0"></label></article><article class="op-card"><h3>Akuma no Mi</h3><label>Fruto<input type="text" name="system.fruit.name" value="{{system.fruit.name}}" ></label><label>Estágio<input type="text" name="system.fruit.stage" value="{{system.fruit.stage}}" ></label><label>Transformações e anotações<textarea name="system.fruit.notes">{{system.fruit.notes}}</textarea></label></article></div>{{> "systems/oprpg-native/templates/groups.hbs" groups=powerGroups}}</section><section data-op-tab="training" aria-label="Treinamentos" {{#unless active.training}}hidden{{/unless}}><article class="op-card"><h3>Pontos de Treinamento · {{system.training.points}} PT</h3><div class="op-buttons"><button type="button" data-action="learnTraining">Aprender treinamento</button><button type="button" data-action="openProgression">PT culturais e histórico</button></div></article>{{> "systems/oprpg-native/templates/groups.hbs" groups=trainingGroups}}<article class="op-card"><h3>Recursos de características</h3><button type="button" data-action="addResource">Adicionar recurso</button>{{#each system.resources}}<input type="hidden" name="system.resources.{{@index}}.id" value="{{id}}"><div class="op-resource-row"><label>Nome<input name="system.resources.{{@index}}.name" value="{{name}}"></label><label>Atual<input type="number" min="0" name="system.resources.{{@index}}.value" value="{{value}}"></label><label>Máximo<input type="number" min="0" name="system.resources.{{@index}}.max" value="{{max}}"></label><input type="hidden" name="system.resources.{{@index}}.recovery" value="{{recovery}}"><input type="hidden" name="system.resources.{{@index}}.source" value="{{source}}"></div>{{/each}}</article></section><section data-op-tab="professions" aria-label="Profissões" {{#unless active.professions}}hidden{{/unless}}>{{> "systems/oprpg-native/templates/groups.hbs" groups=professionGroups}}</section><section data-op-tab="effects" aria-label="Efeitos" {{#unless active.effects}}hidden{{/unless}}><article class="op-card"><h3>Efeitos nativos</h3><button type="button" data-action="configureSituations">Situações da cena</button>{{#if isGM}}<button type="button" data-action="createEffect">Criar modificador</button>{{/if}}<ul class="op-effects">{{#each effects}}<li><img src="{{img}}" alt=""><span>{{name}} · {{#if disabled}}desativado{{else}}ativo{{/if}} · {{duration}}</span>{{#if @root.isGM}}<button type="button" data-action="editEffect" data-effect-id="{{id}}">Editar</button><button type="button" data-action="toggleEffect" data-effect-id="{{id}}">Alternar</button>{{/if}}</li>{{else}}<li class="op-hint">Nenhum efeito registrado.</li>{{/each}}</ul><p class="op-hint">Registre os bônus e as condições concedidos pelas características.</p></article></section><section data-op-tab="personal" aria-label="Personalização" {{#unless active.personal}}hidden{{/unless}}><article class="op-card"><h3>Sonhos, caminhos e história</h3><label>Sonho<input type="text" name="system.personal.dream" value="{{system.personal.dream}}" ></label><label>Caminho<input type="text" name="system.personal.path" value="{{system.personal.path}}" ></label><button type="button" data-action="chooseBackground">Escolher antecedente e benefícios</button><label>Antecedente<input type="text" name="system.personal.background" value="{{system.personal.background}}" ></label><label>Código de honra<input type="text" name="system.personal.honor" value="{{system.personal.honor}}" ></label><label>Personalidade<textarea name="system.personal.personality">{{system.personal.personality}}</textarea></label><label>Anotações<textarea name="system.personal.notes">{{system.personal.notes}}</textarea></label><label>História<textarea name="system.identity.biography">{{system.identity.biography}}</textarea></label></article></section>{{#if showAssistant}}<section data-op-tab="creation" aria-label="Criação" {{#unless active.creation}}hidden{{/unless}}><article class="op-card"><h3>Criação de personagem</h3><div class="op-steps"><span>01 · Espécie</span><span>02 · Estilo</span><span>03 · Profissão</span><span>04 · Atributos</span><span>05 · Personalização</span><span>06 · Token</span></div><h2>Criação e conferência</h2><div class="op-buttons"><button type="button" data-action="applySpecies">Escolher espécie e benefícios</button><button type="button" data-action="advanceLevel">Escolher estilo / avançar nível</button><button type="button" data-action="chooseBackground">Escolher antecedente</button></div>{{#if isGM}}<button type="button" data-action="createSpecies">Criar espécie personalizada</button>{{/if}}<p>{{system.identity.species.name}} · {{system.identity.species.origin}} · v{{system.identity.species.version}}</p><p class="op-traits">{{system.identity.species.traits}}</p><ul class="op-checklist">{{#each checklist}}<li><span>{{#if complete}}✓{{else}}○{{/if}}</span>{{label}}</li>{{/each}}</ul><label class="op-checkbox"><input type="checkbox" name="system.creation.attributesReviewed" {{#if system.creation.attributesReviewed}}checked{{/if}}> Atributos e escolhas conferidos</label><label class="op-checkbox"><input type="checkbox" name="system.creation.resourcesReviewed" {{#if system.creation.resourcesReviewed}}checked{{/if}}> Recursos e conteúdo conferidos</label><p class="op-hint">Os benefícios dependem da fonte e da sua configuração. A aba pode ser desativada sem perder os dados.</p></article></section>{{/if}}</div></div></div></div>
