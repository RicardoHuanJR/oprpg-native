<div class="op-sheet op-item-original op-activity-editor standard-form"><h2 class="op-activity-title">{{activityDisplayName}}</h2><fieldset data-op-fields class="op-body op-item-body"><nav class="op-activity-navigation" aria-label="Configuração da atividade">{{#each activityTabs}}<button type="button" data-action="selectActivityTab" data-tab="{{id}}" aria-pressed="{{active}}"><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i> {{label}}</button>{{/each}}</nav><div {{#unless activityPanels.identity}}hidden{{/unless}}><fieldset class="op-card"><legend>Identidade</legend>{{#if hasSelectedVariant}}<div class="form-group"><label for="{{formPrefix}}-{{variantNamePath}}">Nome</label><div class="form-fields"><input id="{{formPrefix}}-{{variantNamePath}}" name="{{variantNamePath}}" value="{{variantLabel}}"></div></div>{{else}}<div class="form-group"><label for="{{formPrefix}}-name">Nome</label><div class="form-fields"><input id="{{formPrefix}}-name" name="name" value="{{item.name}}"></div></div><div class="form-group"><label for="{{formPrefix}}-img">Ícone</label><div class="form-fields"><input id="{{formPrefix}}-img" name="img" value="{{item.img}}"></div></div>{{/if}}<div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.requirements">Requisitos</label><div class="form-fields"><input id="{{formPrefix}}-{{activityPath}}.requirements" name="{{activityPath}}.requirements" value="{{system.activity.requirements}}"></div></div></fieldset></div><div {{#unless activityPanels.activation}}hidden{{/unless}}><nav class="op-activity-navigation secondary" aria-label="Ativação da atividade">{{#each activitySections}}<button type="button" data-action="selectActivitySection" data-tab="{{id}}" aria-pressed="{{active}}"><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i> {{label}}</button>{{/each}}</nav><div {{#unless activitySectionPanels.time}}hidden{{/unless}}><fieldset class="op-card"><legend>Ativação</legend><div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.activation">Ativação</label><div class="form-fields"><select id="{{formPrefix}}-{{activityPath}}.activation" name="{{activityPath}}.activation">{{#each activations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div></fieldset><fieldset class="op-card"><legend>Duração</legend><div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.duration">Duração</label><div class="form-fields"><input id="{{formPrefix}}-{{activityPath}}.duration" name="{{activityPath}}.duration" value="{{system.activity.duration}}"></div></div><label class="op-checkbox"><input name="{{activityPath}}.concentration" type="checkbox" {{#if system.activity.concentration}}checked{{/if}}> Exige concentração</label></fieldset></div><div {{#unless activitySectionPanels.consumption}}hidden{{/unless}}><fieldset class="op-card"><legend>Custo e consumo</legend><details class="op-consumption-group" {{#if system.activity.ammunitionCost}}open{{/if}}><summary>Munição</summary><div class="op-pair"><div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.ammunitionItem">Munição da ficha</label><div class="form-fields"><select id="{{formPrefix}}-{{activityPath}}.ammunitionItem" name="{{activityPath}}.ammunitionItem"><option value="">Nenhuma</option>{{#each ammunitionOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div></div><div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.ammunitionCost">Unidades por uso</label><div class="form-fields"><input id="{{formPrefix}}-{{activityPath}}.ammunitionCost" type="number" min="0" name="{{activityPath}}.ammunitionCost" value="{{system.activity.ammunitionCost}}"></div></div></div></details><div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.costMode">Origem do custo</label><div class="form-fields"><select id="{{formPrefix}}-{{activityPath}}.costMode" name="{{activityPath}}.costMode">{{#each costModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>{{#if isConstructionCost}}<div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.costFamily">Família da técnica</label><div class="form-fields"><select id="{{formPrefix}}-{{activityPath}}.costFamily" name="{{activityPath}}.costFamily">{{#each costFamilies}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div><div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.creationReduction">Reduções de construção aprovadas (PP)</label><div class="form-fields"><input id="{{formPrefix}}-{{activityPath}}.creationReduction" type="number" min="0" name="{{activityPath}}.creationReduction" value="{{system.activity.creationReduction}}"></div></div><p class="op-hint">Construção aplica o limite de redução de 2 × grau (auxiliar: 6), desconto de estilo e mínimo de 1 PP. Reduções condicionais de características são calculadas no uso.</p>{{/if}}<p>Custo calculado nesta ficha: <strong>{{costQuote.cost}} PP</strong></p><div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.powerCost">Custo em PP</label><div class="form-fields"><input id="{{formPrefix}}-{{activityPath}}.powerCost" type="number" min="0" name="{{activityPath}}.powerCost" value="{{system.activity.powerCost}}"></div></div></fieldset><details class="op-card" {{#if system.uses.max}}open{{/if}}><summary>Reserva de usos</summary><div class="op-pair"><div class="form-group"><label for="{{formPrefix}}-system.uses.value">Usos iniciais</label><div class="form-fields"><input id="{{formPrefix}}-system.uses.value" type="number" min="0" name="system.uses.value" value="{{system.uses.value}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.uses.max">Máximo de usos (0: sem limite)</label><div class="form-fields"><input id="{{formPrefix}}-system.uses.max" type="number" min="0" name="system.uses.max" value="{{system.uses.max}}"></div></div></div><div class="form-group"><label for="{{formPrefix}}-system.uses.recovery">Recuperação de usos</label><div class="form-fields"><select id="{{formPrefix}}-system.uses.recovery" name="system.uses.recovery">{{#each recoveries}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div><p class="op-hint">Após o primeiro uso, a reserva atual aparece nos recursos da ficha do ator. Não é reabastecida ao reabrir o item.</p>
      </details></div><div {{#unless activitySectionPanels.target}}hidden{{/unless}}><fieldset class="op-card"><legend>Alvos</legend><div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.targetLabel">Alvos da técnica</label><div class="form-fields"><input id="{{formPrefix}}-{{activityPath}}.targetLabel" name="{{activityPath}}.targetLabel" value="{{system.activity.targetLabel}}" placeholder="Ex.: 1 criatura, próprio"></div></div></fieldset><fieldset class="op-card"><legend>Alcance</legend><div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.range">Alcance</label><div class="form-fields"><input id="{{formPrefix}}-{{activityPath}}.range" name="{{activityPath}}.range" value="{{system.activity.range}}"></div></div></fieldset></div></div><div {{#unless activityPanels.effect}}hidden{{/unless}}><fieldset class="op-card"><legend>Detalhes do ataque</legend><div class="form-group"><label for="{{formPrefix}}-{{resolutionPath}}.kind">Resolução</label><div class="form-fields"><select id="{{formPrefix}}-{{resolutionPath}}.kind" name="{{resolutionPath}}.kind">{{#each resolutionKinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>{{#if isSave}}<div class="form-group"><label for="{{formPrefix}}-{{resolutionPath}}.saveAttribute">Atributo da salvaguarda</label><div class="form-fields"><select id="{{formPrefix}}-{{resolutionPath}}.saveAttribute" name="{{resolutionPath}}.saveAttribute">{{#each saveAttributes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div><div class="form-group"><label for="{{formPrefix}}-{{resolutionPath}}.onSave">Dano em salvaguarda bem-sucedida</label><div class="form-fields"><select id="{{formPrefix}}-{{resolutionPath}}.onSave" name="{{resolutionPath}}.onSave">{{#each saveOutcomes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
      {{/if}}{{#if isTechnique}}<div class="form-group"><label for="{{formPrefix}}-system.grade">Grau da técnica</label><div class="form-fields"><input id="{{formPrefix}}-system.grade" type="number" min="1" max="7" name="system.grade" value="{{system.grade}}"></div></div>{{/if}}
      <div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.attribute">Atributo</label><div class="form-fields"><select id="{{formPrefix}}-{{activityPath}}.attribute" name="{{activityPath}}.attribute">{{#each attributes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
      {{#if isLegendary}}<div class="form-group"><label for="{{formPrefix}}-{{resolutionPath}}.legendaryCost">Custo na reserva lendária</label><div class="form-fields"><input id="{{formPrefix}}-{{resolutionPath}}.legendaryCost" type="number" min="1" name="{{resolutionPath}}.legendaryCost" value="{{system.resolution.legendaryCost}}"></div></div>{{/if}}{{#if isGM}}<label class="op-checkbox"><input type="checkbox" name="{{resolutionPath}}.ignoreBudget" {{#if system.resolution.ignoreBudget}}checked{{/if}}> Exceção da fonte: não consumir ação comum</label>{{/if}}<div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.proficiencyMode">Proficiência</label><div class="form-fields"><select id="{{formPrefix}}-{{activityPath}}.proficiencyMode" name="{{activityPath}}.proficiencyMode"><option value="manual">Configurada neste item</option><option value="style" {{#if styleProficiency}}selected{{/if}}>Consultar estilos do personagem</option></select></div></div><label class="op-checkbox"><input type="checkbox" name="{{activityPath}}.proficient" {{#if system.activity.proficient}}checked{{/if}}> Adicionar proficiência à rolagem de referência</label>
      <label class="op-checkbox"><input type="checkbox" name="{{resolutionPath}}.addAttributeToAttack" {{#if system.resolution.addAttributeToAttack}}checked{{/if}}> Adicionar atributo ao ataque (somente se a fonte permitir)</label>
      </fieldset><fieldset class="op-card"><legend>Dano e resolução</legend><div class="form-group"><label for="{{formPrefix}}-{{activityPath}}.damageFormula">Fórmula de dano</label><div class="form-fields"><input id="{{formPrefix}}-{{activityPath}}.damageFormula" name="{{activityPath}}.damageFormula" value="{{system.activity.damageFormula}}"></div></div><label class="op-checkbox"><input type="checkbox" name="{{activityPath}}.surgicalControl" {{#if system.activity.surgicalControl}}checked{{/if}}> Registrar Controle Cirúrgico nesta atividade</label>
      {{#if isAttack}}<div class="form-group"><label for="{{formPrefix}}-{{resolutionPath}}.attackBonus">Bônus fixo de ataque (NPC/fonte)</label><div class="form-fields"><input id="{{formPrefix}}-{{resolutionPath}}.attackBonus" type="number" name="{{resolutionPath}}.attackBonus" value="{{system.resolution.attackBonus}}" placeholder="Vazio: atributo + proficiência configurados"></div></div>{{/if}}{{#if isSave}}<div class="form-group"><label for="{{formPrefix}}-{{resolutionPath}}.saveDC">CD fixa da fonte</label><div class="form-fields"><input id="{{formPrefix}}-{{resolutionPath}}.saveDC" type="number" name="{{resolutionPath}}.saveDC" value="{{system.resolution.saveDC}}"></div></div>{{/if}}<div class="form-group"><label for="{{formPrefix}}-{{resolutionPath}}.damageType">Tipo de dano</label><div class="form-fields"><select id="{{formPrefix}}-{{resolutionPath}}.damageType" name="{{resolutionPath}}.damageType">{{#each damageTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div><label class="op-checkbox"><input type="checkbox" name="{{resolutionPath}}.addAttributeToDamage" {{#if system.resolution.addAttributeToDamage}}checked{{/if}}> Adicionar atributo ao dano (somente se a fonte permitir)</label>{{#if isAttack}}<div class="form-group"><label for="{{formPrefix}}-{{resolutionPath}}.criticalThreshold">Margem crítica</label><div class="form-fields"><input id="{{formPrefix}}-{{resolutionPath}}.criticalThreshold" type="number" min="1" max="20" name="{{resolutionPath}}.criticalThreshold" value="{{system.resolution.criticalThreshold}}"></div></div>
      {{/if}}</fieldset></div>{{#if canRoll}}<div class="op-buttons"><button type="button" data-action="rollActivity">Rolar referência</button><button type="button" data-action="useActivity">Usar e gastar PP</button><button type="button" data-action="rollDamage">Rolar dano</button></div>{{/if}}
    </fieldset></div>