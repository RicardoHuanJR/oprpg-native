<header class="sheet-header op-npc-header"><div class="left"><div class="portrait"><img src="{{portraitImage}}" alt="{{actor.name}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}></div></div><div class="middle"><label class="op-name"><span class="sr-only">Nome</span><input class="document-name" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><p class="document-subtitle">INIMIGO · ND {{system.challenge}}</p><div class="op-pair"><label>Nível de desafio<input name="system.challenge" value="{{system.challenge}}"></label><label>Experiência concedida<input type="number" min="0" name="system.rewardXP" value="{{system.rewardXP}}"></label><label>Proficiência do bloco<input type="number" min="0" name="system.proficiencyOverride" value="{{system.proficiencyOverride}}"></label><label>CD do bloco<input type="number" min="0" name="system.saveDifficulty" value="{{system.saveDifficulty}}"></label></div></div><div class="right"><div class="level-badge badge">{{system.challenge}}</div></div></header>
