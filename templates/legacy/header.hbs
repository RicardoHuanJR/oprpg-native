<header class="sheet-header" style="--op-old-header:url('{{headerArt}}')">
  {{#if primaryStyleName}}<span class="op-header-context"><span aria-hidden="true">⚔</span> {{primaryStyleName}}</span>{{/if}}
  <div class="left"><label class="document-name"><span class="sr-only">Nome</span><input name="name" class="uninput" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><div class="class roboto-upper">{{headerStyleLabel}}</div></div>
  <div class="right"><button type="button" class="level-badge badge unbutton" data-action="advanceLevel" title="Subir nível" aria-label="Subir nível · nível {{system.progression.level}}">{{system.progression.level}}</button>
    <button type="button" class="op-header-config unbutton" data-action="openSheetConfiguration" aria-label="Configurações da ficha"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>
    <div class="sheet-header-buttons"><button type="button" class="gold-button" data-action="startShortRest" aria-label="Iniciar descanso curto"><i class="fa-solid fa-utensils"></i></button><button type="button" class="gold-button" data-action="startRest" aria-label="Descanso longo"><i class="fa-solid fa-flask"></i></button><button type="button" class="gold-button" data-action="openPowers" aria-label="Haki"><i class="fa-solid fa-hand-fist"></i></button><button type="button" class="gold-button" data-action="openFeatureUses" aria-label="Usos de características"><i class="fa-solid fa-bolt"></i></button></div>
  </div>
</header>
