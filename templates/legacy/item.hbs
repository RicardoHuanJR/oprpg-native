<div class="op-sheet op-item-original">
<header class="sheet-header"><div class="left"><img class="document-image" src="{{item.img}}" alt="Imagem de {{item.name}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}></div><div class="middle identity-info"><label class="op-name"><span class="sr-only">Nome</span><input class="document-name" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}></label><ul class="subtitles unlist"><li>{{category}}</li><li>{{system.origin}}</li></ul></div></header>
<nav class="op-item-navigation" aria-label="Abas do item">{{#each itemTabs}}<button type="button" data-action="selectItemTab" data-tab="{{id}}" aria-pressed="{{active}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}</nav>
<fieldset data-op-fields class="op-body op-item-body">
<section class="op-item-panel" data-item-panel="description" aria-label="Descrição" {{#unless itemPanels.description}}hidden{{/unless}}>
<article class="op-card"><h3>Origem e referência</h3><div class="op-pair"><label>Origem<select name="system.origin">{{#each origins}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Versão do conteúdo<input name="system.contentVersion" value="{{system.contentVersion}}"></label></div><label>Identificador do conteúdo<input name="system.identifier" value="{{system.identifier}}" placeholder="ex.: afinidade-cultural"></label><label>Livro, edição e página / autoria<input name="system.source" value="{{system.source}}"></label><label class="op-checkbox"><input type="checkbox" name="system.rulesReviewed" {{#if system.rulesReviewed}}checked{{/if}}> Regras e exceções conferidas na fonte</label><label>Descrição<textarea name="system.description">{{system.description}}</textarea></label></article>
</section>
<section class="op-item-panel" data-item-panel="details" aria-label="Detalhes" {{#unless itemPanels.details}}hidden{{/unless}}>
{{#if isWeapon}}<article class="op-card"><h3>Arma e expertise</h3><button type="button" data-action="configureWeapon">Categoria e propriedades</button><label>Expertise no crítico natural<textarea name="system.weapon.expertise">{{system.weapon.expertise}}</textarea></label><p class="op-hint">Exige 20 natural em ataque comum e proficiência nesta arma. Somente um efeito de expertise pode permanecer ativo por criatura.</p><label class="op-checkbox"><input name="system.weapon.reload" type="checkbox" {{#if system.weapon.reload}}checked{{/if}}> Recarga: um disparo por rodada</label><div class="op-pair"><label>Alcance normal (m)<input type="number" min="0" step="any" name="system.weapon.normalRange" value="{{system.weapon.normalRange}}"></label><label>Alcance máximo (m)<input type="number" min="0" step="any" name="system.weapon.maximumRange" value="{{system.weapon.maximumRange}}"></label></div></article>{{/if}}
<article class="op-card"><h3>Dial (quando aplicável)</h3><label>Modelo<select name="system.dial.model"><option value="">Não é dial</option>{{#each dialModels}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Dano do conteúdo absorvido (quando aplicável)<input name="system.dial.damageFormula" value="{{system.dial.damageFormula}}"></label><label>Tipo de dano do conteúdo<input name="system.dial.damageType" value="{{system.dial.damageType}}"></label><p class="op-hint">Carga, descarga e absorção rápida são operadas pelo painel de regras do portador.</p></article><article class="op-card"><h3>Requisitos</h3><label>Requisito mínimo de nível<input type="number" min="1" name="system.levelRequirement" value="{{system.levelRequirement}}"></label><label>Pré-requisitos da fonte<input name="system.prerequisite" value="{{system.prerequisite}}"></label>{{#if isEquipment}}<div class="op-pair"><label>Quantidade<input type="number" min="0" name="system.equipment.quantity" value="{{system.equipment.quantity}}"></label><label>Peso por unidade (kg)<input type="number" min="0" step="any" name="system.equipment.weight" value="{{system.equipment.weight}}"></label><label>Dano desta munição<input name="system.ammunitionDamage" value="{{system.ammunitionDamage}}"></label><label>Tipo de dano da munição<select name="system.ammunitionType">{{#each ammunitionTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Preço (฿)<input type="number" min="0" name="system.equipment.price" value="{{system.equipment.price}}"></label><label class="op-checkbox"><input type="checkbox" name="system.equipment.consumable" {{#if system.equipment.consumable}}checked{{/if}}> Consumível</label><label class="op-checkbox"><input type="checkbox" name="system.equipment.equipped" {{#if system.equipment.equipped}}checked{{/if}}> Equipado</label></div>{{/if}}</article>
    {{#if isProfession}}<article class="op-card"><h3>Profissão e reconhecimento</h3><button type="button" data-action="calculateProfession">Calcular aperfeiçoamento</button><button type="button" data-action="configureProfessionTools">Ferramentas da profissão</button><label>Graduação<select name="system.profession.rank">{{#each professionRanks}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Feitos e reconhecimentos<textarea name="system.profession.recognition">{{system.profession.recognition}}</textarea></label></article>{{/if}}
    {{#if isSpecies}}<article class="op-card"><h3>Traços da espécie</h3><label>PV base<input type="number" min="0" name="system.baseHP" value="{{system.baseHP}}"></label><label>Deslocamento (m)<input type="number" min="0" step="any" name="system.movement" value="{{system.movement}}"></label><label>Natação (m)<input type="number" min="0" step="any" name="system.swimming" value="{{system.swimming}}"></label><button type="button" data-action="configureSpecies">Bônus e ancestralidades</button><label>Traços e benefícios<textarea name="system.traits">{{system.traits}}</textarea></label><p class="op-hint">Conteúdo personalizado é identificado como Homebrew. As escolhas de progressão aplicam aumentos e proficiências, preservando os atributos base. Configure os demais traços conforme a fonte; edições posteriores não alteram escolhas já registradas.</p></article>{{/if}}
    {{#if isProgression}}<article class="op-card"><h3>Progressão e escolhas</h3><div class="op-buttons"><button type="button" data-action="configureStyleProficiencies">Proficiências</button><button type="button" data-action="configureRequirements">Requisitos de Multiestilo</button></div><label>Tipo do Dado de Vida<input type="number" min="6" max="12" step="2" name="system.hitDie" value="{{system.hitDie}}"></label><label>Atributo principal<select name="system.primaryAttribute">{{#each primaryAttributes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Equipamento inicial e observações<textarea name="system.initialEquipmentNote">{{system.initialEquipmentNote}}</textarea></label><label>Imagem do cabeçalho deste estilo<input name="system.headerImage" value="{{system.headerImage}}" placeholder="Caminho da imagem ou endereço"></label><label>Perícias escolhidas no primeiro estilo<input type="number" name="system.skillCount" value="{{system.skillCount}}" min="0"></label><p class="op-hint">Escolhas podem usar nível de estilo ou nível total de personagem. O primeiro estilo define a Habilidade Básica Inata; novos estilos usam os requisitos de Multiestilo.</p></article>{{/if}}
{{#if isTraining}}<article class="op-card"><h3>Aprendizado</h3><button type="button" data-action="configureRequirements">Atributos e espécies exigidos</button><div class="op-pair"><label>Custo em PT<input type="number" name="system.training.cost" value="{{system.training.cost}}" min="0"></label><label>Dias de treinamento<input type="number" name="system.training.days" value="{{system.training.days}}" min="0"></label></div><label class="op-checkbox"><input type="checkbox" name="system.training.tutorRequired" {{#if system.training.tutorRequired}}checked{{/if}}> Exige tutor</label><label class="op-checkbox"><input type="checkbox" name="system.training.repeatable" {{#if system.training.repeatable}}checked{{/if}}> Pode ser aprendido repetidamente</label><label>Outros requisitos a conferir<input name="system.training.manualRequirement" value="{{system.training.manualRequirement}}"></label><p class="op-hint">Cada dia exige seis horas de treinamento. Tutor opcional reduz o tempo pela metade, arredondado para cima.</p><h3>Benefícios condicionais sobre outros treinos</h3>{{#if editable}}<button type="button" data-action="addTrainingException">Adicionar exceção</button>{{/if}}{{#each trainingExceptions}}<div class="op-step-row"><span>{{name}}<br><small>Custo {{cost}} PT · {{days}} dias{{#if ignoreRequirements}} · Ignora requisitos{{/if}}</small></span>{{#if @root.editable}}<button type="button" data-action="editTrainingException" data-index="{{index}}">Configurar</button><button type="button" data-action="removeTrainingException" data-index="{{index}}" aria-label="Remover exceção">×</button>{{/if}}</div>{{/each}}</article>{{/if}}
    {{#if isHakiTalent}}<article class="op-card"><h3>Aprendizado de Haki</h3><label>Tipo<select name="system.hakiTalent.focus">{{#each hakiFocus}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Custo de aquisição (PA)<input type="number" min="0" name="system.hakiTalent.cost" value="{{system.hakiTalent.cost}}"></label><label>Estágio mínimo<select name="system.hakiTalent.minimumStage">{{#each hakiStages}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if canRoll}}<button type="button" data-action="learnHakiTalent">Aprender e distribuir PA</button>{{/if}}</article>{{/if}}
</section>
<section class="op-item-panel" data-item-panel="activities" aria-label="Atividades" {{#unless itemPanels.activities}}hidden{{/unless}}>
{{#if hasActivity}}<article class="op-card"><h3>Atividades e alternativas</h3><div class="op-buttons"><button type="button" data-action="selectVariant" data-variant-id="">Principal</button>{{#each variants}}<button type="button" data-action="selectVariant" data-variant-id="{{id}}" aria-pressed="{{selected}}">{{name}}</button>{{/each}}<button type="button" data-action="addVariant">Adicionar alternativa</button></div>{{#if hasSelectedVariant}}<label>Nome da alternativa<input name="{{variantNamePath}}" value="{{variantLabel}}"></label><button type="button" data-action="removeVariant">Remover alternativa</button>{{/if}}<label class="op-checkbox"><input name="{{activityPath}}.concentration" type="checkbox" {{#if system.activity.concentration}}checked{{/if}}> Exige concentração</label><label>Resolução<select name="{{resolutionPath}}.kind">{{#each resolutionKinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if isSave}}<label>Atributo da salvaguarda<select name="{{resolutionPath}}.saveAttribute">{{#each saveAttributes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Dano em salvaguarda bem-sucedida<select name="{{resolutionPath}}.onSave">{{#each saveOutcomes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      {{/if}}{{#if isTechnique}}<label>Grau da técnica<input type="number" min="1" max="7" name="system.grade" value="{{system.grade}}"></label>{{/if}}
      <div class="op-pair"><label>Atributo<select name="{{activityPath}}.attribute">{{#each attributes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Ativação<select name="{{activityPath}}.activation">{{#each activations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>
      {{#if isLegendary}}<label>Custo na reserva lendária<input type="number" min="1" name="{{resolutionPath}}.legendaryCost" value="{{system.resolution.legendaryCost}}"></label>{{/if}}{{#if isGM}}<label class="op-checkbox"><input type="checkbox" name="{{resolutionPath}}.ignoreBudget" {{#if system.resolution.ignoreBudget}}checked{{/if}}> Exceção da fonte: não consumir ação comum</label>{{/if}}<label>Proficiência<select name="{{activityPath}}.proficiencyMode"><option value="manual">Configurada neste item</option><option value="style" {{#if styleProficiency}}selected{{/if}}>Consultar estilos do personagem</option></select></label><label class="op-checkbox"><input type="checkbox" name="{{activityPath}}.proficient" {{#if system.activity.proficient}}checked{{/if}}> Adicionar proficiência à rolagem de referência</label>
      <label class="op-checkbox"><input type="checkbox" name="{{resolutionPath}}.addAttributeToAttack" {{#if system.resolution.addAttributeToAttack}}checked{{/if}}> Adicionar atributo ao ataque (somente se a fonte permitir)</label>
      <div class="op-pair"><label>Munição da ficha<select name="{{activityPath}}.ammunitionItem"><option value="">Nenhuma</option>{{#each ammunitionOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Unidades por uso<input type="number" min="0" name="{{activityPath}}.ammunitionCost" value="{{system.activity.ammunitionCost}}"></label></div><label>Origem do custo<select name="{{activityPath}}.costMode">{{#each costModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Família da técnica<select name="{{activityPath}}.costFamily">{{#each costFamilies}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Reduções de construção aprovadas (PP)<input type="number" min="0" name="{{activityPath}}.creationReduction" value="{{system.activity.creationReduction}}"></label><p class="op-hint">Custo final preserva o valor publicado. Construção aplica o limite de redução de 2 × grau (auxiliar: 6), desconto de estilo e mínimo de 1 PP. Reduções condicionais de características são calculadas no uso.</p><p>Custo calculado nesta ficha: <strong>{{costQuote.cost}} PP</strong></p><label>Custo em PP<input type="number" min="0" name="{{activityPath}}.powerCost" value="{{system.activity.powerCost}}"></label><label>Fórmula de dano<input name="{{activityPath}}.damageFormula" value="{{system.activity.damageFormula}}"></label><div class="op-pair"><label>Alcance<input name="{{activityPath}}.range" value="{{system.activity.range}}"></label><label>Duração<input name="{{activityPath}}.duration" value="{{system.activity.duration}}"></label></div><label>Requisitos<input name="{{activityPath}}.requirements" value="{{system.activity.requirements}}"></label><label class="op-checkbox"><input type="checkbox" name="{{activityPath}}.surgicalControl" {{#if system.activity.surgicalControl}}checked{{/if}}> Registrar Controle Cirúrgico nesta atividade</label>
      {{#if isAttack}}<label>Bônus fixo de ataque (NPC/fonte)<input type="number" name="{{resolutionPath}}.attackBonus" value="{{system.resolution.attackBonus}}" placeholder="Vazio: atributo + proficiência configurados"></label>{{/if}}{{#if isSave}}<label>CD fixa da fonte<input type="number" name="{{resolutionPath}}.saveDC" value="{{system.resolution.saveDC}}"></label>{{/if}}<label>Tipo de dano<select name="{{resolutionPath}}.damageType">{{#each damageTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label class="op-checkbox"><input type="checkbox" name="{{resolutionPath}}.addAttributeToDamage" {{#if system.resolution.addAttributeToDamage}}checked{{/if}}> Adicionar atributo ao dano (somente se a fonte permitir)</label>{{#if isAttack}}<label>Margem crítica<input type="number" min="1" max="20" name="{{resolutionPath}}.criticalThreshold" value="{{system.resolution.criticalThreshold}}"></label>
      {{/if}}<div class="op-pair"><label>Usos iniciais<input type="number" min="0" name="system.uses.value" value="{{system.uses.value}}"></label><label>Máximo de usos (0: sem limite)<input type="number" min="0" name="system.uses.max" value="{{system.uses.max}}"></label></div><label>Recuperação de usos<select name="system.uses.recovery">{{#each recoveries}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><p class="op-hint">Após o primeiro uso, a reserva atual aparece nos recursos da ficha do ator. Não é reabastecida ao reabrir o item.</p>
      <p class="op-hint">Uso confirma gasto de PP neste cliente. Limites por turno, usos de características, alvos e exceções ainda estão em reconstrução. Shift no dano dobra dados sem dobrar modificadores.</p>{{#if canRoll}}<div class="op-buttons"><button type="button" data-action="rollActivity">Rolar referência</button><button type="button" data-action="useActivity">Usar e gastar PP</button><button type="button" data-action="rollDamage">Rolar dano</button></div>{{/if}}
    </article>{{/if}}
</section>
<section class="op-item-panel" data-item-panel="benefits" aria-label="Progressão e benefícios" {{#unless itemPanels.benefits}}hidden{{/unless}}>
<article class="op-card"><header><h3>Benefícios e condições</h3>{{#if editable}}<button type="button" data-action="addItemRule">Adicionar benefício</button>{{/if}}</header>{{#each itemRules}}<div class="op-step-row"><span>{{kindLabel}} · {{amount}}<br><small>{{key}}{{#if condition.context}} · {{condition.context}}{{/if}}{{#if condition.aboveHalfHP}} · Acima de metade dos PV{{/if}}</small></span>{{#if @root.editable}}<button type="button" data-action="editItemRule" data-index="{{index}}">Configurar</button><button type="button" data-action="removeItemRule" data-index="{{index}}" aria-label="Remover benefício">×</button>{{/if}}</div>{{else}}<p class="op-hint">Adicione bônus, vantagens e condições conforme a fonte.</p>{{/each}}</article>
    {{#if hasAdvancement}}<article class="op-card"><header><h3>Escolhas e benefícios por nível</h3>{{#if editable}}<button type="button" data-action="addAdvancement">Adicionar escolha</button>{{/if}}</header>{{#each advancementSteps}}<div class="op-step-row"><span>{{label}}<br><small>Nível {{level}} de {{scopeLabel}} · {{count}} escolha(s){{#if initialOnly}} · Primeiro estilo{{/if}}</small></span>{{#if @root.editable}}<button type="button" data-action="editAdvancement" data-index="{{index}}">Configurar</button><button type="button" data-action="removeAdvancement" data-index="{{index}}" aria-label="Remover escolha">×</button>{{/if}}</div>{{else}}<p class="op-hint">Nenhuma escolha configurada. Adicione benefícios para a espécie, antecedente, estilo ou treinamento.</p>{{/each}}</article>{{/if}}
</section>
<section class="op-item-panel" data-item-panel="effects" {{#unless itemPanels.effects}}hidden{{/unless}}><article class="op-card"><h3>Efeitos do item</h3>{{#if isGM}}<button type="button" data-action="createItemEffect">Criar efeito</button>{{/if}}{{#each itemEffects}}<div class="op-step-row"><span>{{name}} · {{#if disabled}}desativado{{else}}ativo{{/if}}</span>{{#if @root.isGM}}<button type="button" data-action="editItemEffect" data-effect-id="{{id}}">Editar</button>{{/if}}</div>{{else}}<p class="op-hint">Nenhum efeito configurado.</p>{{/each}}</article></section></fieldset></div>
