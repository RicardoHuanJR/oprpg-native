<div class="op-sheet op-item-original">
<header class="sheet-header"><div class="left"><img class="document-image" src="{{itemImage}}" alt="Imagem de {{item.name}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}></div><div class="middle identity-info">{{#if editable}}<label class="op-name"><span class="sr-only">Nome</span><input class="document-name" name="name" value="{{item.name}}"></label>{{else}}<h1 class="document-name op-read-name">{{item.name}}</h1>{{/if}}<ul class="subtitles unlist"><li>{{category}}</li><li>{{#each origins}}{{#if selected}}{{label}}{{/if}}{{/each}}</li></ul></div>{{#if isEquipment}}<div class="op-item-header-values"><span title="Quantidade">× {{system.equipment.quantity}}</span><span title="Peso por unidade">{{system.equipment.weight}} kg</span><span title="Preço">{{system.equipment.price}} ฿</span></div>{{/if}}</header>
<nav class="op-item-navigation" aria-label="Abas do item">{{#each itemTabs}}<button type="button" data-action="selectItemTab" data-tab="{{id}}" aria-pressed="{{active}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}</nav>
<fieldset data-op-fields class="op-body op-item-body">
<section class="op-item-panel" data-item-panel="description" aria-label="Descrição" {{#unless itemPanels.description}}hidden{{/unless}}>
{{#if editable}}<fieldset class="op-card"><legend>Origem e referência</legend><div class="op-pair"><div class="form-group"><label for="{{formPrefix}}-system.origin">Origem</label><div class="form-fields"><select id="{{formPrefix}}-system.origin" name="system.origin">{{#each origins}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div><div class="form-group"><label for="{{formPrefix}}-system.contentVersion">Versão do conteúdo</label><div class="form-fields"><input id="{{formPrefix}}-system.contentVersion" name="system.contentVersion" value="{{system.contentVersion}}"></div></div></div><div class="form-group"><label for="{{formPrefix}}-system.identifier">Identificador do conteúdo</label><div class="form-fields"><input id="{{formPrefix}}-system.identifier" name="system.identifier" value="{{system.identifier}}" placeholder="ex.: afinidade-cultural"></div></div><div class="form-group"><label for="{{formPrefix}}-system.source">Livro, edição e página / autoria</label><div class="form-fields"><input id="{{formPrefix}}-system.source" name="system.source" value="{{system.source}}"></div></div><label class="op-checkbox"><input type="checkbox" name="system.rulesReviewed" {{#if system.rulesReviewed}}checked{{/if}}> Regras e exceções conferidas na fonte</label><div class="form-group"><label for="{{formPrefix}}-system.description">Descrição</label><div class="form-fields"><textarea id="{{formPrefix}}-system.description" name="system.description">{{system.description}}</textarea></div></div></fieldset>{{else}}<details class="op-card op-item-description" open><summary>Descrição</summary><p class="op-hint">{{system.source}}</p><div class="op-enriched-content">{{#if descriptionHTML}}{{{descriptionHTML}}}{{else}}<p>Nenhuma descrição registrada. Use Editar ficha para preencher.</p>{{/if}}</div></details>{{/if}}
{{#if weaponBookRules}}<details class="op-card"><summary>Proficiência, expertise e propriedades das armas</summary>{{{weaponBookRules}}}</details>{{/if}}<div class="op-item-summary-tags">{{#each itemSummaryTags}}<span>{{this}}</span>{{/each}}</div></section>
<section class="op-item-panel" data-item-panel="details" aria-label="Detalhes" {{#unless itemPanels.details}}hidden{{/unless}}>
{{#if isWeapon}}<fieldset class="op-card"><legend>Arma e expertise</legend><div class="op-weapon-properties">{{#each system.weapon.properties}}<span><i class="fa-solid fa-lock" aria-hidden="true"></i> {{this}}</span>{{/each}}</div><button type="button" data-action="configureWeapon">Categoria e propriedades</button><div class="form-group"><label for="{{formPrefix}}-system.weapon.expertise">Expertise no crítico natural</label><div class="form-fields"><textarea id="{{formPrefix}}-system.weapon.expertise" name="system.weapon.expertise">{{system.weapon.expertise}}</textarea></div></div><p class="op-hint">Exige 20 natural em ataque comum e proficiência nesta arma. Somente um efeito de expertise pode permanecer ativo por criatura.</p><label class="op-checkbox"><input name="system.weapon.reload" type="checkbox" {{#if system.weapon.reload}}checked{{/if}}> Recarga: um disparo por rodada</label><div class="op-pair"><div class="form-group"><label for="{{formPrefix}}-system.weapon.normalRange">Alcance normal (m)</label><div class="form-fields"><input id="{{formPrefix}}-system.weapon.normalRange" type="number" min="0" step="any" name="system.weapon.normalRange" value="{{system.weapon.normalRange}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.weapon.maximumRange">Alcance máximo (m)</label><div class="form-fields"><input id="{{formPrefix}}-system.weapon.maximumRange" type="number" min="0" step="any" name="system.weapon.maximumRange" value="{{system.weapon.maximumRange}}"></div></div></div></fieldset>{{/if}}
{{#if showDialConfig}}<details class="op-card" {{#if system.dial.model}}open{{/if}}><summary>Configuração de Dial</summary><div class="form-group"><label for="{{formPrefix}}-system.dial.model">Modelo</label><div class="form-fields"><select id="{{formPrefix}}-system.dial.model" name="system.dial.model"><option value="">Não é dial</option>{{#each dialModels}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div><div class="form-group"><label for="{{formPrefix}}-system.dial.damageFormula">Dano do conteúdo absorvido (quando aplicável)</label><div class="form-fields"><input id="{{formPrefix}}-system.dial.damageFormula" name="system.dial.damageFormula" value="{{system.dial.damageFormula}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.dial.damageType">Tipo de dano do conteúdo</label><div class="form-fields"><input id="{{formPrefix}}-system.dial.damageType" name="system.dial.damageType" value="{{system.dial.damageType}}"></div></div><p class="op-hint">Carga, descarga e absorção rápida são operadas pelo painel de regras do portador.</p></details>{{/if}}<fieldset class="op-card"><legend>Requisitos</legend><div class="form-group"><label for="{{formPrefix}}-system.levelRequirement">Requisito mínimo de nível</label><div class="form-fields"><input id="{{formPrefix}}-system.levelRequirement" type="number" min="1" name="system.levelRequirement" value="{{system.levelRequirement}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.prerequisite">Pré-requisitos da fonte</label><div class="form-fields"><input id="{{formPrefix}}-system.prerequisite" name="system.prerequisite" value="{{system.prerequisite}}"></div></div>{{#if isEquipment}}<div class="op-pair"><div class="form-group"><label for="{{formPrefix}}-system.equipment.quantity">Quantidade</label><div class="form-fields"><input id="{{formPrefix}}-system.equipment.quantity" type="number" min="0" name="system.equipment.quantity" value="{{system.equipment.quantity}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.equipment.weight">Peso por unidade (kg)</label><div class="form-fields"><input id="{{formPrefix}}-system.equipment.weight" type="number" min="0" step="any" name="system.equipment.weight" value="{{system.equipment.weight}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.ammunitionDamage">Dano desta munição</label><div class="form-fields"><input id="{{formPrefix}}-system.ammunitionDamage" name="system.ammunitionDamage" value="{{system.ammunitionDamage}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.ammunitionType">Tipo de dano da munição</label><div class="form-fields"><select id="{{formPrefix}}-system.ammunitionType" name="system.ammunitionType">{{#each ammunitionTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div><div class="form-group"><label for="{{formPrefix}}-system.equipment.price">Preço (฿)</label><div class="form-fields"><input id="{{formPrefix}}-system.equipment.price" type="number" min="0" name="system.equipment.price" value="{{system.equipment.price}}"></div></div><label class="op-checkbox"><input type="checkbox" name="system.equipment.consumable" {{#if system.equipment.consumable}}checked{{/if}}> Consumível</label><label class="op-checkbox"><input type="checkbox" name="system.equipment.equipped" {{#if system.equipment.equipped}}checked{{/if}}> Equipado</label></div>{{/if}}</fieldset>
    {{#if isWithoutProfession}}<fieldset class="op-card"><legend>Sem Profissão</legend><p class="op-hint">Ajudante Perfeito · Foco · Parceiro de Treino · Tempo Livre. Esta escolha impede aprender profissões e não possui graduação profissional.</p>{{#if canOperateProfession}}<button type="button" data-action="operateProfession">Benefícios e Ajudante Perfeito</button>{{/if}}</fieldset>{{else}}{{#if isProfession}}<fieldset class="op-card"><legend>Profissão e reconhecimento</legend>{{#if canOperateProfession}}<button type="button" data-action="operateProfession">Realizar característica profissional</button>{{/if}}<button type="button" data-action="calculateProfession">Calcular aperfeiçoamento</button><button type="button" data-action="configureProfessionTools">Ferramentas da profissão</button><div class="form-group"><label for="{{formPrefix}}-system.profession.rank">Graduação</label><div class="form-fields"><select id="{{formPrefix}}-system.profession.rank" name="system.profession.rank">{{#each professionRanks}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div><div class="form-group"><label for="{{formPrefix}}-system.profession.recognition">Feitos e reconhecimentos</label><div class="form-fields"><textarea id="{{formPrefix}}-system.profession.recognition" name="system.profession.recognition">{{system.profession.recognition}}</textarea></div></div></fieldset>{{/if}}{{/if}}
    {{#if isSpecies}}<div class="form-group"><label for="{{formPrefix}}-system.family">Raça principal</label><div class="form-fields"><input id="{{formPrefix}}-system.family" name="system.family" value="{{system.family}}" placeholder="Ex.: Humanos"></div></div><fieldset class="op-card"><legend>Traços da espécie</legend><div class="form-group"><label for="{{formPrefix}}-system.baseHP">PV base</label><div class="form-fields"><input id="{{formPrefix}}-system.baseHP" type="number" min="0" name="system.baseHP" value="{{system.baseHP}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.movement">Deslocamento (m)</label><div class="form-fields"><input id="{{formPrefix}}-system.movement" type="number" min="0" step="any" name="system.movement" value="{{system.movement}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.swimming">Natação (m)</label><div class="form-fields"><input id="{{formPrefix}}-system.swimming" type="number" min="0" step="any" name="system.swimming" value="{{system.swimming}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.traits">Traços e benefícios</label><div class="form-fields"><textarea id="{{formPrefix}}-system.traits" name="system.traits">{{system.traits}}</textarea></div></div><p class="op-hint">Traços oficiais da raça. As escolhas individuais são feitas na aquisição.</p></fieldset>{{/if}}
    {{#if isProgression}}<fieldset class="op-card"><legend>Progressão e escolhas</legend><div class="op-buttons"><button type="button" data-action="configureRequirements">Requisitos de Multiestilo</button></div><div class="form-group"><label for="{{formPrefix}}-system.hitDie">Tipo do Dado de Vida</label><div class="form-fields"><input id="{{formPrefix}}-system.hitDie" type="number" min="6" max="12" step="2" name="system.hitDie" value="{{system.hitDie}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.primaryAttribute">Atributo principal</label><div class="form-fields"><select id="{{formPrefix}}-system.primaryAttribute" name="system.primaryAttribute">{{#each primaryAttributes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div><div class="form-group"><label for="{{formPrefix}}-system.initialEquipmentNote">Equipamento inicial e observações</label><div class="form-fields"><textarea id="{{formPrefix}}-system.initialEquipmentNote" name="system.initialEquipmentNote">{{system.initialEquipmentNote}}</textarea></div></div><div class="form-group"><label for="{{formPrefix}}-system.headerImage">Imagem do cabeçalho deste estilo</label><div class="form-fields"><input id="{{formPrefix}}-system.headerImage" name="system.headerImage" value="{{system.headerImage}}" placeholder="Caminho da imagem ou endereço"></div></div><div class="form-group"><label for="{{formPrefix}}-system.skillCount">Perícias escolhidas no primeiro estilo</label><div class="form-fields"><input id="{{formPrefix}}-system.skillCount" type="number" name="system.skillCount" value="{{system.skillCount}}" min="0"></div></div><p class="op-hint">Escolhas podem usar nível de estilo ou nível total de personagem. O primeiro estilo define a Habilidade Básica Inata; novos estilos usam os requisitos de Multiestilo.</p></fieldset>{{/if}}
{{#if isTraining}}<fieldset class="op-card"><legend>Aprendizado</legend><button type="button" data-action="configureRequirements">Atributos e espécies exigidos</button><div class="op-pair"><div class="form-group"><label for="{{formPrefix}}-system.training.cost">Custo em PT</label><div class="form-fields"><input id="{{formPrefix}}-system.training.cost" type="number" name="system.training.cost" value="{{system.training.cost}}" min="0"></div></div><div class="form-group"><label for="{{formPrefix}}-system.training.days">Dias de treinamento</label><div class="form-fields"><input id="{{formPrefix}}-system.training.days" type="number" name="system.training.days" value="{{system.training.days}}" min="0"></div></div></div><label class="op-checkbox"><input type="checkbox" name="system.training.tutorRequired" {{#if system.training.tutorRequired}}checked{{/if}}> Exige tutor</label><label class="op-checkbox"><input type="checkbox" name="system.training.repeatable" {{#if system.training.repeatable}}checked{{/if}}> Pode ser aprendido repetidamente</label><div class="form-group"><label for="{{formPrefix}}-system.training.manualRequirement">Outros requisitos a conferir</label><div class="form-fields"><input id="{{formPrefix}}-system.training.manualRequirement" name="system.training.manualRequirement" value="{{system.training.manualRequirement}}"></div></div><p class="op-hint">Cada dia exige seis horas de treinamento. Tutor opcional reduz o tempo pela metade, arredondado para cima.</p><h3>Benefícios condicionais sobre outros treinos</h3>{{#if editable}}<button type="button" data-action="addTrainingException">Adicionar exceção</button>{{/if}}{{#each trainingExceptions}}<div class="op-step-row"><span>{{name}}<br><small>Custo {{cost}} PT · {{days}} dias{{#if ignoreRequirements}} · Ignora requisitos{{/if}}</small></span>{{#if @root.editable}}<button type="button" data-action="editTrainingException" data-index="{{index}}">Configurar</button><button type="button" data-action="removeTrainingException" data-index="{{index}}" aria-label="Remover exceção">×</button>{{/if}}</div>{{/each}}</fieldset>{{/if}}
    {{#if isHakiTalent}}<fieldset class="op-card"><legend>Aprendizado de Haki</legend><p class="op-hint">Forma adquirida: {{system.hakiTalent.rank}} / {{system.hakiTalent.maxRank}}</p>{{#if editable}}<button type="button" data-action="configureHakiRequirements">Pré-requisitos e formas</button>{{/if}}<div class="form-group"><label for="{{formPrefix}}-system.hakiTalent.focus">Tipo</label><div class="form-fields"><select id="{{formPrefix}}-system.hakiTalent.focus" name="system.hakiTalent.focus">{{#each hakiFocus}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div><div class="form-group"><label for="{{formPrefix}}-system.hakiTalent.cost">Custo de aquisição (PA)</label><div class="form-fields"><input id="{{formPrefix}}-system.hakiTalent.cost" type="number" min="0" name="system.hakiTalent.cost" value="{{system.hakiTalent.cost}}"></div></div><div class="form-group"><label for="{{formPrefix}}-system.hakiTalent.minimumStage">Estágio mínimo</label><div class="form-fields"><select id="{{formPrefix}}-system.hakiTalent.minimumStage" name="system.hakiTalent.minimumStage">{{#each hakiStages}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>{{#if canLearnHaki}}<button type="button" data-action="learnHakiTalent">Aprender próxima forma e distribuir PA</button>{{/if}}</fieldset>{{/if}}
</section>
<section class="op-item-panel" data-item-panel="activities" aria-label="Atividades" {{#unless itemPanels.activities}}hidden{{/unless}}>
{{#if hasActivity}}<ul class="op-activities-list"><li><i class="fa-solid fa-burst" aria-hidden="true"></i><div><strong>{{item.name}}</strong><small>{{system.activity.damageFormula}}</small></div><button type="button" data-action="openActivityEditor" data-variant-id="" aria-label="Configurar atividade principal"><i class="fa-solid fa-gear" aria-hidden="true"></i></button></li>{{#each variants}}<li><i class="fa-solid fa-burst" aria-hidden="true"></i><strong>{{name}}</strong><button type="button" data-action="openActivityEditor" data-variant-id="{{id}}" aria-label="Configurar {{name}}"><i class="fa-solid fa-gear" aria-hidden="true"></i></button></li>{{/each}}</ul>{{#if editable}}<button type="button" data-action="addVariant"><i class="fa-solid fa-plus" aria-hidden="true"></i> Adicionar atividade alternativa</button>{{/if}}{{/if}}
</section>
<section class="op-item-panel" data-item-panel="benefits" aria-label="Progressão e benefícios" {{#unless itemPanels.benefits}}hidden{{/unless}}>
<article class="op-card"><header><h3>Benefícios e condições</h3>{{#if editable}}<button type="button" data-action="addItemRule">Adicionar benefício</button>{{/if}}</header>{{#each itemRules}}<div class="op-step-row"><span>{{kindLabel}} · {{amount}}<br><small>{{keyLabel}}{{#if condition.context}} · {{condition.context}}{{/if}}{{#if condition.aboveHalfHP}} · Acima de metade dos PV{{/if}}</small></span>{{#if @root.editable}}<button type="button" data-action="editItemRule" data-index="{{index}}">Configurar</button><button type="button" data-action="removeItemRule" data-index="{{index}}" aria-label="Remover benefício">×</button>{{/if}}</div>{{else}}<p class="op-hint">Adicione bônus, vantagens e condições conforme a fonte.</p>{{/each}}</article>
    {{#if hasAdvancement}}<article class="op-card"><header><h3>Escolhas e benefícios por nível</h3>{{#if editable}}<button type="button" data-action="addAdvancement">Adicionar escolha</button>{{/if}}</header>{{#each advancementSteps}}<div class="op-step-row"><span>{{label}}<br><small>Nível {{level}} de {{scopeLabel}} · {{count}} escolha(s){{#if initialOnly}} · Primeiro estilo{{/if}}</small></span>{{#if @root.editable}}<button type="button" data-action="editAdvancement" data-index="{{index}}">Configurar</button><button type="button" data-action="removeAdvancement" data-index="{{index}}" aria-label="Remover escolha">×</button>{{/if}}</div>{{else}}<p class="op-hint">Nenhuma escolha configurada. Adicione benefícios para a espécie, antecedente, estilo ou treinamento.</p>{{/each}}</article>{{/if}}
</section>
<section class="op-item-panel" data-item-panel="effects" {{#unless itemPanels.effects}}hidden{{/unless}}><fieldset class="op-card"><legend>Efeitos do item</legend>{{#if isGM}}<button type="button" data-action="createItemEffect">Criar efeito</button>{{/if}}{{#each itemEffects}}<div class="op-step-row"><span>{{name}} · {{#if disabled}}desativado{{else}}ativo{{/if}}</span>{{#if @root.isGM}}<button type="button" data-action="editItemEffect" data-effect-id="{{id}}">Editar</button>{{/if}}</div>{{else}}<p class="op-hint">Nenhum efeito configurado.</p>{{/each}}</fieldset></section></fieldset></div>
