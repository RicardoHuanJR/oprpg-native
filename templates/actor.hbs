<div class="op-sheet">
  <header class="op-header">
    <img src="{{actor.img}}" alt="Retrato de {{actor.name}}" data-action="showPortraitArtwork">
    <div class="op-heading"><p class="op-eyebrow">ONE PIECE RPG <span>EXPERIMENTAL 0.1</span></p>
      <label class="op-name"><span class="sr-only">Nome</span><input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label>
      <p class="op-subtitle">{{#if isNPC}}NPC / Inimigo{{else}}Personagem{{/if}} · {{#if system.identity.species.name}}{{system.identity.species.name}}{{else}}Espécie não selecionada{{/if}}</p>
    </div>
    <label class="op-level">Nível<input type="number" name="system.progression.level" value="{{system.progression.level}}" min="1" max="20" {{#unless editable}}disabled{{/unless}}></label>
  </header>
  <nav class="op-tabs" aria-label="Seções da ficha">
    <button type="button" data-action="selectTab" data-tab="details" aria-pressed="{{detailsActive}}">Ficha</button>
    <button type="button" data-action="selectTab" data-tab="content" aria-pressed="{{contentActive}}">Itens e técnicas</button>
    {{#if showAssistant}}<button type="button" data-action="selectTab" data-tab="creation" aria-pressed="{{creationActive}}">Criação de personagem</button>{{/if}}
  </nav>
  <fieldset {{#unless editable}}disabled{{/unless}} class="op-body">
    <section aria-label="Ficha" {{#unless detailsActive}}hidden{{/unless}}>
      <div class="op-resources">
        <article class="op-card op-health"><h3>Pontos de Vida</h3><div class="op-pair"><label>Atuais<input type="number" min="0" name="system.vitality.value" value="{{system.vitality.value}}"></label><label>Máximos<input type="number" min="0" name="system.vitality.max" value="{{system.vitality.max}}"></label></div><div class="op-pair"><label>Temporários<input type="number" min="0" name="system.vitality.temporary" value="{{system.vitality.temporary}}"></label><label>Negativos<input type="number" min="0" name="system.vitality.negative" value="{{system.vitality.negative}}"></label></div></article>
        <article class="op-card op-power"><h3>Pontos de Poder</h3><div class="op-pair"><label>Atuais<input type="number" min="0" name="system.power.value" value="{{system.power.value}}"></label><div class="op-stat"><span>Máximos</span><strong>{{system.power.max}}</strong></div></div><label>Máximo personalizado<input type="number" min="0" name="system.power.maxOverride" value="{{system.power.maxOverride}}" placeholder="Automático: 4 × nível"></label></article>
        <article class="op-card"><h3>Defesa e movimento</h3><label>Classe de Resistência<input type="number" name="system.defense.rating" value="{{system.defense.rating}}"></label><label>Deslocamento (m)<input type="number" min="0" step="0.1" name="system.movement.distance" value="{{system.movement.distance}}"></label><div class="op-inline">Proficiência <strong>+{{system.proficiency.bonus}}</strong></div></article>
      </div>
      <h2>Atributos</h2><div class="op-attributes">
      {{#each attributes}}<article class="op-attribute"><h3>{{label}}</h3><label><span class="sr-only">Valor de {{label}}</span><input type="number" min="1" name="system.attributes.{{id}}.base" value="{{base}}"></label><strong class="op-modifier">{{modifier}}</strong><button type="button" data-action="rollAttribute" data-attribute="{{id}}">Testar</button><label class="op-checkbox"><input type="checkbox" name="system.attributes.{{id}}.saveProficient" {{#if saveProficient}}checked{{/if}}> Prof. salva</label><button type="button" data-action="rollAttribute" data-attribute="{{id}}" data-save="true">Salvaguarda</button></article>{{/each}}
      </div><p class="op-hint">Shift: vantagem · Alt: desvantagem · Shift + Alt: rolagem normal.</p>
      <div class="op-two-col"><article class="op-card"><h3>Identidade</h3><label>Estilo de combate<input name="system.identity.combatStyle" value="{{system.identity.combatStyle}}"></label><label>Profissão<input name="system.identity.profession" value="{{system.identity.profession}}"></label><label>História e anotações<textarea name="system.identity.biography">{{system.identity.biography}}</textarea></label></article>
      <article class="op-card"><h3>Espécie / Raça</h3><p>{{#if system.identity.species.name}}{{system.identity.species.name}} · {{system.identity.species.origin}} · v{{system.identity.species.version}}{{else}}Nenhuma espécie selecionada.{{/if}}</p><p class="op-traits">{{system.identity.species.traits}}</p><label>Selecionar conteúdo disponível<select data-species-picker><option value="">Escolha uma espécie</option>{{#each species}}<option value="{{id}}">{{name}}{{#if homebrew}} — Homebrew{{/if}}</option>{{/each}}</select></label><button type="button" data-action="applySpecies">Registrar espécie na ficha</button><p class="op-hint">Traços são descritivos nesta versão. Benefícios devem ser conferidos e aplicados manualmente.</p>{{#if isGM}}<button type="button" data-action="createSpecies">Criar espécie personalizada</button>{{/if}}</article></div>
      {{#if isNPC}}<article class="op-card"><h3>Configuração de NPC</h3><label>Bônus de proficiência<input type="number" min="0" name="system.proficiencyOverride" value="{{system.proficiencyOverride}}"></label><div class="op-pair"><label>Ações lendárias restantes<input type="number" min="0" name="system.legendaryActions.value" value="{{system.legendaryActions.value}}"></label><label>Máximo de ações lendárias<input type="number" min="0" name="system.legendaryActions.max" value="{{system.legendaryActions.max}}"></label></div><p class="op-hint">Controle e recuperação manuais. Esta ficha não armazena segredos do mestre.</p></article>{{/if}}
    </section>
    <section aria-label="Itens e técnicas" {{#unless contentActive}}hidden{{/unless}}>
      {{#each groups}}<article class="op-card op-item-group"><header><h3>{{label}}</h3><button type="button" data-action="createItem" data-type="{{type}}">Adicionar</button></header><ul>{{#each items}}<li><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button>{{#if grade}}<span>{{grade}}º grau</span>{{/if}}{{#if homebrew}}<span class="op-badge">Homebrew</span>{{/if}}</li>{{else}}<li class="op-hint">Nenhum conteúdo registrado.</li>{{/each}}</ul></article>{{/each}}
    </section>
    {{#if showAssistant}}<section aria-label="Criação de personagem" {{#unless creationActive}}hidden{{/unless}}>
      <div class="op-steps"><span>01 · Espécie</span><span>02 · Estilo</span><span>03 · Profissão</span><span>04 · Atributos</span><span>05 · Conferência</span></div>
      <article class="op-card"><h2>Monte sua ficha</h2><p>Use a aba Ficha para preencher as escolhas. Este guia acompanha a conferência; não concede benefícios automaticamente.</p><ul class="op-checklist">{{#each checklist}}<li><span>{{#if complete}}✓{{else}}○{{/if}}</span>{{label}}</li>{{/each}}</ul><label class="op-checkbox"><input type="checkbox" name="system.creation.attributesReviewed" {{#if system.creation.attributesReviewed}}checked{{/if}}> Atributos e escolhas conferidos com a fonte</label><label class="op-checkbox"><input type="checkbox" name="system.creation.resourcesReviewed" {{#if system.creation.resourcesReviewed}}checked{{/if}}> Recursos, defesa e conteúdo conferidos com a fonte</label><p class="op-hint">O mestre pode desativar esta aba nas configurações do sistema. Seus dados serão preservados.</p></article>
    </section>{{/if}}
  </fieldset>
</div>
