<div class="op-classic-sheet {{#if sidebarCollapsed}}op-sidebar-collapsed{{/if}}"><header class="op-header" {{#if headerArt}}style="--op-header-art:url('{{headerArt}}')"{{/if}}><div class="op-heading"><label class="op-name"><span class="sr-only">Nome</span><input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><p class="op-subtitle">{{#if isShip}}Embarcação{{else if isNPC}}NPC / Inimigo{{else}}Personagem{{/if}} · {{primaryStyleName}}</p></div>{{#if isCharacter}}<button type="button" class="op-level-control" data-action="openProgression" title="Progressão e escolhas"><small>NÍVEL</small><strong>{{system.progression.level}}</strong></button>{{/if}}{{#unless isShip}}<div class="op-header-actions"><button type="button" data-action="chooseHeaderArt" title="Imagem do cabeçalho" aria-label="Imagem do cabeçalho"><i class="fa-solid fa-image" aria-hidden="true"></i></button><button type="button" data-action="startShortRest" title="Iniciar descanso curto" aria-label="Iniciar descanso curto"><i class="fa-solid fa-utensils" aria-hidden="true"></i></button><button type="button" data-action="startRest" title="Iniciar descanso longo" aria-label="Iniciar descanso longo"><i class="fa-solid fa-flask" aria-hidden="true"></i></button><button type="button" data-action="openPowers" title="Haki e Akuma no Mi" aria-label="Haki e Akuma no Mi"><i class="fa-solid fa-hand-fist" aria-hidden="true"></i></button><button type="button" data-action="openProgression" title="Progressão, origens e treinamentos" aria-label="Progressão, origens e treinamentos"><i class="fa-solid fa-bolt" aria-hidden="true"></i></button></div>{{/unless}}</header><div class="op-layout"><aside class="op-sidebar"><div class="op-character-card"><button type="button" class="op-sidebar-collapser" data-action="toggleSidebar" aria-label="Recolher ou expandir retrato e recursos">‹</button><div class="op-portrait"><img src="{{portraitImage}}" data-fallback="{{actor.img}}" alt="Retrato de {{actor.name}}" {{#unless tokenPortrait}}{{#if editable}}data-action="editImage" data-edit="img"{{else}}data-action="showPortraitArtwork"{{/if}}{{/unless}}></div>{{#unless isShip}}{{#if editable}}<button type="button" class="op-portrait-switch" data-action="togglePortrait">{{#if tokenPortrait}}Mostrar retrato{{else}}Mostrar token{{/if}}</button>{{/if}}{{/unless}}<fieldset data-op-fields>{{#unless isShip}}
<div class="op-defense-row"><div class="op-exhaustion-pips">{{#each exhaustionLeft}}<button type="button" data-action="setExhaustion" data-level="{{level}}" aria-label="Exaustão {{level}}" aria-pressed="{{filled}}"></button>{{/each}}</div><div class="op-classic-defense"><span>CLASSE DE RESISTÊNCIA</span><label><span class="sr-only">Classe de Resistência</span><input type="number" name="system.defense.rating" value="{{system.defense.rating}}"></label><small>CR</small></div><div class="op-exhaustion-pips">{{#each exhaustionRight}}<button type="button" data-action="setExhaustion" data-level="{{level}}" aria-label="Exaustão {{level}}" aria-pressed="{{filled}}"></button>{{/each}}</div></div>
<div class="op-lozenges"><div><strong>{{initiativeBonus}}</strong><span>INICIATIVA</span></div><div><strong>{{system.effectiveMovement}}<small> m</small></strong><span>MOVIMENTO</span></div><div><strong>+{{system.proficiency.bonus}}</strong><span>PROFICIÊNCIA</span></div></div>
<div class="op-classic-resource"><header><h3>Pontos de Vida</h3><button type="button" data-action="configureResources" aria-label="Configurar recursos">⚙</button></header><div class="op-meter op-meter-health"><span style="width:{{healthPercent}}%"></span><label><input type="number" min="0" name="system.vitality.value" value="{{system.vitality.value}}" aria-label="PV atuais"><b>/ {{system.vitality.max}}</b></label></div><p class="op-resource-notes">Temporários {{system.vitality.temporary}} · Negativos {{system.vitality.negative}}</p><div class="op-buttons"><button type="button" data-action="damage">Dano</button><button type="button" data-action="heal">Cura</button><button type="button" data-action="temporary">Temporários</button></div></div>
<div class="op-classic-resource"><header><h3>Pontos de Poder</h3></header><div class="op-meter op-meter-power"><span style="width:{{powerPercent}}%"></span><label><input type="number" min="0" name="system.power.value" value="{{system.power.value}}" aria-label="PP atuais"><b>/ {{system.power.max}}</b></label></div></div>
<div class="op-classic-resource"><header><h3>Dados de Vida</h3></header><div class="op-meter op-meter-dice"><label>{{#if hasAutomatedLevels}}<strong>{{system.hitDice.available}}</strong>{{else}}<input type="number" name="system.hitDice.available" value="{{system.hitDice.available}}" min="0" aria-label="Dados de Vida disponíveis">{{/if}}<b>/ {{system.hitDice.max}}</b></label></div></div>{{/unless}}</fieldset><div class="op-favorites"><h3>▣ Favoritos</h3><ul>{{#each favorites}}<li><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button>{{#if canUse}}<button type="button" data-action="useItem" data-item-id="{{id}}">Usar</button>{{/if}}</li>{{else}}<li class="op-empty-favorite">Marque um item como favorito</li>{{/each}}</ul></div></div></aside><div class="op-main"><nav class="op-tabs op-tabs-wide op-tabs-right" aria-label="Seções da ficha">{{#each tabs}}<button type="button" data-action="selectTab" data-tab="{{id}}" aria-pressed="{{active}}" title="{{label}}" aria-label="{{label}}"><i class="{{icon}}" aria-hidden="true"></i><span class="sr-only">{{label}}</span></button>{{/each}}</nav><fieldset data-op-fields class="op-body"><section data-op-tab="details" aria-label="Detalhes" {{#unless active.details}}hidden{{/unless}}>{{#if isShip}}<article class="op-card"><h3>Embarcação</h3><label>PV atuais<input type="number" name="system.vitality.value" value="{{system.vitality.value}}" min="0"></label><label>PV máximos<input type="number" name="system.vitality.max" value="{{system.vitality.max}}" min="0"></label><label>CR<input type="number" name="system.defense.rating" value="{{system.defense.rating}}" ></label><label>Tamanho<input type="text" name="system.structure.size" value="{{system.structure.size}}" ></label><label>Deques<input type="number" name="system.structure.decks" value="{{system.structure.decks}}" min="0"></label><label>Cômodos<input type="number" name="system.structure.rooms" value="{{system.structure.rooms}}" min="0"></label><label>Tripulantes<input type="number" name="system.crew.current" value="{{system.crew.current}}" min="0"></label><label>Efetivo necessário<input type="number" name="system.crew.required" value="{{system.crew.required}}" min="0"></label><label>Capacidade<input type="number" name="system.crew.capacity" value="{{system.crew.capacity}}" min="0"></label><label>Movimento (m)<input type="number" name="system.movement.distance" value="{{system.movement.distance}}" min="0" step="any"></label><label>Rumo<input type="text" name="system.navigation.heading" value="{{system.navigation.heading}}" ></label><label>Clima<input type="text" name="system.navigation.weather" value="{{system.navigation.weather}}" ></label><label>Diário de navegação<textarea name="system.navigation.notes">{{system.navigation.notes}}</textarea></label></article>{{else}}<div class="op-attributes">{{#each attributes}}<div class="op-ability-emblem"><button type="button" data-action="rollAttribute" data-attribute="{{id}}" title="Teste de {{label}}">{{abbreviation}}</button><strong>{{signedModifier}}</strong><label><span class="sr-only">Valor de {{label}}</span><input type="number" min="1" name="system.attributes.{{id}}.base" value="{{base}}"></label></div>{{/each}}</div><p class="op-hint">Shift: vantagem · Alt: desvantagem · Shift + Alt: normal. Exaustão é incluída no d20.</p><div class="op-two-col"><article class="op-card"><h3><i class="fa-solid fa-briefcase" aria-hidden="true"></i> Perícias</h3><ul class="op-skills">{{#each skillGroups}}<li class="op-skill-separator">{{label}}</li>{{#each skills}}<li><input type="checkbox" aria-label="Proficiência em {{label}}" name="system.skills.{{id}}.proficient" {{#if proficient}}checked{{/if}}><span class="op-skill-abbreviation">{{abbreviation}}</span><button type="button" data-action="rollSkill" data-skill="{{id}}">{{label}}</button><span>{{total}}</span><span class="op-hint">{{passive}}</span>{{#if @root.editable}}<button type="button" class="op-skill-config" data-action="configureSkill" data-skill="{{id}}" aria-label="Configurar {{label}}">⚙</button>{{/if}}</li>{{/each}}{{/each}}</ul></article><div class="op-detail-right"><article class="op-card op-saves"><h3><i class="fa-solid fa-shield-heart" aria-hidden="true"></i> Salvaguardas</h3><ul>{{#each attributes}}<li><input type="checkbox" name="system.attributes.{{id}}.saveProficient" {{#if saveProficient}}checked{{/if}} aria-label="Proficiência em salvaguarda de {{label}}"><button type="button" data-action="rollAttribute" data-attribute="{{id}}" data-save="true" title="Salvaguarda de {{label}}">{{abbreviation}}</button><strong>{{saveTotal}}</strong>{{#if @root.isNPC}}<input type="number" step="1" name="system.attributes.{{id}}.saveOverride" value="{{saveOverride}}" placeholder="Fonte" aria-label="Bônus de salvaguarda de {{label}} informado pelo bloco">{{/if}}</li>{{/each}}</ul></article><div class="op-identity-pills"><div><small>ESPÉCIE</small><strong>{{system.identity.species.name}}</strong></div><div><small>ESTILO DE COMBATE</small><strong>{{system.identity.combatStyle}}</strong></div><div><small>PROFISSÃO</small><strong>{{system.identity.profession}}</strong></div></div>{{#if isNPC}}<article class="op-card"><h3>Bloco de inimigo</h3><label>Nível de Desafio (aceita fração)<input type="text" name="system.challenge" value="{{system.challenge}}" ></label><label>Pontos de Experiência concedidos<input type="number" name="system.rewardXP" value="{{system.rewardXP}}" min="0"></label><label>Bônus de Proficiência<input type="number" name="system.proficiencyOverride" value="{{system.proficiencyOverride}}" min="0"></label><label>Classe de Dificuldade<input type="number" name="system.saveDifficulty" value="{{system.saveDifficulty}}" ></label><label>Deslocamento (m)<input type="number" name="system.movement.distance" value="{{system.movement.distance}}" min="0" step="any"></label><label>Lendárias restantes<input type="number" name="system.legendaryActions.value" value="{{system.legendaryActions.value}}" min="0"></label><label>Máximo lendário<input type="number" name="system.legendaryActions.max" value="{{system.legendaryActions.max}}" min="0"></label><label>Sentidos<input type="text" name="system.senses" value="{{system.senses}}" ></label><p class="op-hint">Preencha os valores do bloco de inimigo. PP não são calculados pelo nível de personagem.</p></article>{{else}}<article class="op-card"><details class="op-settings"><summary>Identidade e progresso</summary><p>Espécie: <strong>{{system.identity.species.name}}</strong></p><label>Estilo de combate<input type="text" name="system.identity.combatStyle" value="{{system.identity.combatStyle}}" ></label><label>Profissão<input type="text" name="system.identity.profession" value="{{system.identity.profession}}" ></label><label>Pontos de Experiência<input type="number" name="system.experience" value="{{system.experience}}" min="0"></label><label>Deslocamento base (m)<input type="number" name="system.movement.distance" value="{{system.movement.distance}}" min="0" step="any"></label><p>Peso {{system.inventoryWeight}} kg · Carga {{system.carryingCapacity}} kg</p><details class="op-settings"><summary>Descansos e Dados de Vida</summary>{{#if hasAutomatedLevels}}<ul>{{#each system.hitDice.pools}}<li>d{{faces}} · {{available}} / {{max}}</li>{{/each}}</ul>{{else}}<label>Tipo do Dado de Vida<input type="number" name="system.hitDice.faces" value="{{system.hitDice.faces}}" min="6" max="12" step="2"></label><label>DV máximos<input type="number" name="system.hitDice.max" value="{{system.hitDice.max}}" min="0"></label>{{/if}}<div class="op-buttons"><button type="button" data-action="startShortRest">Iniciar descanso curto</button><button type="button" data-action="finishShortRest">Concluir descanso curto</button><button type="button" data-action="hitDie">Gastar DV</button><button type="button" data-action="startRest">Iniciar descanso longo</button><button type="button" data-action="finishRest">Concluir descanso longo</button></div></details></details></article>{{/if}}</div></div>{{/if}}</section><section data-op-tab="inventory" aria-label="Inventário" {{#unless active.inventory}}hidden{{/unless}}><button type="button" data-action="browseInventory">Adicionar item do catálogo / da mesa</button>{{#unless isShip}}<article class="op-card"><h3>Dinheiro</h3><label>฿<input type="number" name="system.currency" value="{{system.currency}}" min="0"></label></article>{{/unless}}{{> "systems/oprpg-native/templates/groups.hbs" groups=inventoryGroups}}</section><section data-op-tab="features" aria-label="Características" {{#unless active.features}}hidden{{/unless}}>{{#if isCharacter}}<article class="op-card"><h3>Estilos de combate</h3><div class="op-buttons"><button type="button" data-action="advanceLevel">Avançar nível / Multiestilo</button><button type="button" data-action="openProgression">Origens e histórico</button></div><ul>{{#each styleLevels}}<li>{{name}} · {{levels}} nível(is) · d{{hitDie}}</li>{{else}}<li>Escolha um estilo para iniciar a progressão.</li>{{/each}}</ul></article>{{/if}}{{> "systems/oprpg-native/templates/groups.hbs" groups=featureGroups}}</section><section data-op-tab="techniques" aria-label="Técnicas" {{#unless active.techniques}}hidden{{/unless}}>{{> "systems/oprpg-native/templates/groups.hbs" groups=techniqueGroups}}</section><section data-op-tab="powers" aria-label="Haki e Akuma" {{#unless active.powers}}hidden{{/unless}}><div class="op-two-col"><article class="op-card"><h3>Haki · {{system.haki.stage}}</h3>{{#if isGM}}<button type="button" data-action="awardAmbition">Conceder PA</button><label class="op-checkbox"><input type="checkbox" name="system.haki.awakened" {{#if system.haki.awakened}}checked{{/if}}> Despertar autorizado</label><label class="op-checkbox"><input type="checkbox" name="system.haki.kingAllowed" {{#if system.haki.kingAllowed}}checked{{/if}}> Haki do Rei autorizado</label>{{/if}}<label>PA ociosos<input type="number" name="system.haki.unspent" value="{{system.haki.unspent}}" min="0"></label><label>PA em Armamento<input type="number" name="system.haki.armament" value="{{system.haki.armament}}" min="0"></label><label>PA em Observação<input type="number" name="system.haki.observation" value="{{system.haki.observation}}" min="0"></label><label>PA em Rei<input type="number" name="system.haki.king" value="{{system.haki.king}}" min="0"></label></article><article class="op-card"><h3>Akuma no Mi</h3><label>Fruto<input type="text" name="system.fruit.name" value="{{system.fruit.name}}" ></label><label>Estágio<input type="text" name="system.fruit.stage" value="{{system.fruit.stage}}" ></label><label>Transformações e anotações<textarea name="system.fruit.notes">{{system.fruit.notes}}</textarea></label></article></div>{{> "systems/oprpg-native/templates/groups.hbs" groups=powerGroups}}</section><section data-op-tab="training" aria-label="Treinamentos" {{#unless active.training}}hidden{{/unless}}><article class="op-card"><h3>Pontos de Treinamento · {{system.training.points}} PT</h3><div class="op-buttons"><button type="button" data-action="learnTraining">Aprender treinamento</button><button type="button" data-action="openProgression">PT culturais e histórico</button></div></article>{{> "systems/oprpg-native/templates/groups.hbs" groups=trainingGroups}}<article class="op-card"><h3>Recursos de características</h3><button type="button" data-action="addResource">Adicionar recurso</button>{{#each system.resources}}<input type="hidden" name="system.resources.{{@index}}.id" value="{{id}}"><div class="op-resource-row"><label>Nome<input name="system.resources.{{@index}}.name" value="{{name}}"></label><label>Atual<input type="number" min="0" name="system.resources.{{@index}}.value" value="{{value}}"></label><label>Máximo<input type="number" min="0" name="system.resources.{{@index}}.max" value="{{max}}"></label><input type="hidden" name="system.resources.{{@index}}.recovery" value="{{recovery}}"><input type="hidden" name="system.resources.{{@index}}.source" value="{{source}}"></div>{{/each}}</article></section><section data-op-tab="professions" aria-label="Profissões" {{#unless active.professions}}hidden{{/unless}}>{{> "systems/oprpg-native/templates/groups.hbs" groups=professionGroups}}</section><section data-op-tab="effects" aria-label="Efeitos" {{#unless active.effects}}hidden{{/unless}}><article class="op-card"><h3>Efeitos nativos</h3><button type="button" data-action="configureSituations">Situações da cena</button>{{#if isGM}}<button type="button" data-action="createEffect">Criar modificador</button>{{/if}}<ul class="op-effects">{{#each effects}}<li><img src="{{img}}" alt=""><span>{{name}} · {{#if disabled}}desativado{{else}}ativo{{/if}} · {{duration}}</span>{{#if @root.isGM}}<button type="button" data-action="editEffect" data-effect-id="{{id}}">Editar</button><button type="button" data-action="toggleEffect" data-effect-id="{{id}}">Alternar</button>{{/if}}</li>{{else}}<li class="op-hint">Nenhum efeito registrado.</li>{{/each}}</ul><p class="op-hint">Registre os bônus e as condições concedidos pelas características.</p></article></section><section data-op-tab="personal" aria-label="Personalização" {{#unless active.personal}}hidden{{/unless}}><article class="op-card"><h3>Sonhos, caminhos e história</h3><label>Sonho<input type="text" name="system.personal.dream" value="{{system.personal.dream}}" ></label><label>Caminho<input type="text" name="system.personal.path" value="{{system.personal.path}}" ></label><button type="button" data-action="chooseBackground">Escolher antecedente e benefícios</button><label>Antecedente<input type="text" name="system.personal.background" value="{{system.personal.background}}" ></label><label>Código de honra<input type="text" name="system.personal.honor" value="{{system.personal.honor}}" ></label><label>Personalidade<textarea name="system.personal.personality">{{system.personal.personality}}</textarea></label><label>Anotações<textarea name="system.personal.notes">{{system.personal.notes}}</textarea></label><label>História<textarea name="system.identity.biography">{{system.identity.biography}}</textarea></label></article></section>{{#if showAssistant}}<section data-op-tab="creation" aria-label="Criação" {{#unless active.creation}}hidden{{/unless}}><article class="op-card"><h3>Criação de personagem</h3><div class="op-steps"><span>01 · Espécie</span><span>02 · Estilo</span><span>03 · Profissão</span><span>04 · Atributos</span><span>05 · Personalização</span><span>06 · Token</span></div><h2>Criação e conferência</h2><div class="op-buttons"><button type="button" data-action="applySpecies">Escolher espécie e benefícios</button><button type="button" data-action="advanceLevel">Escolher estilo / avançar nível</button><button type="button" data-action="chooseBackground">Escolher antecedente</button></div>{{#if isGM}}<button type="button" data-action="createSpecies">Criar espécie personalizada</button>{{/if}}<p>{{system.identity.species.name}} · {{system.identity.species.origin}} · v{{system.identity.species.version}}</p><p class="op-traits">{{system.identity.species.traits}}</p><ul class="op-checklist">{{#each checklist}}<li><span>{{#if complete}}✓{{else}}○{{/if}}</span>{{label}}</li>{{/each}}</ul><label class="op-checkbox"><input type="checkbox" name="system.creation.attributesReviewed" {{#if system.creation.attributesReviewed}}checked{{/if}}> Atributos e escolhas conferidos</label><label class="op-checkbox"><input type="checkbox" name="system.creation.resourcesReviewed" {{#if system.creation.resourcesReviewed}}checked{{/if}}> Recursos e conteúdo conferidos</label><p class="op-hint">Os benefícios dependem da fonte e da sua configuração. A aba pode ser desativada sem perder os dados.</p></article></section>{{/if}}</fieldset></div></div></div>