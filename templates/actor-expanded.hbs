<div class="op-layout"><aside class="op-sidebar"><div class="op-portrait"><img src="{{actor.img}}" alt="Retrato de {{actor.name}}" {{#if editable}}data-action="editImage" data-edit="img"{{else}}data-action="showPortraitArtwork"{{/if}}></div><fieldset {{#unless editable}}disabled{{/unless}}>{{#unless isShip}}<article class="op-card"><h3>Pontos de Vida</h3><div class="op-pair"><label>Atuais<input type="number" name="system.vitality.value" value="{{system.vitality.value}}" min="0"></label><label>Máximos<input type="number" name="system.vitality.max" value="{{system.vitality.max}}" min="0"></label></div><div class="op-pair"><label>Temporários<input type="number" name="system.vitality.temporary" value="{{system.vitality.temporary}}" min="0"></label><label>Negativos<input type="number" name="system.vitality.negative" value="{{system.vitality.negative}}" min="0"></label></div><div class="op-buttons"><button type="button" data-action="damage">Dano</button><button type="button" data-action="heal">Cura</button><button type="button" data-action="temporary">PV temp.</button></div></article><article class="op-card"><h3>Pontos de Poder</h3><label>Atuais<input type="number" name="system.power.value" value="{{system.power.value}}" min="0"></label><p>Máximos <strong>{{system.power.max}}</strong></p><label>Máximo da fonte<input type="number" name="system.power.maxOverride" value="{{system.power.maxOverride}}" min="0" placeholder="Automático"></label></article><article class="op-card"><h3>Combate</h3><label>Classe de Resistência<input type="number" name="system.defense.rating" value="{{system.defense.rating}}" ></label><label>Exaustão<input type="number" name="system.exhaustion" value="{{system.exhaustion}}" min="0" max="6"></label><p>Proficiência +{{system.proficiency.bonus}}</p><p>Movimento efetivo {{system.effectiveMovement}} m</p></article>{{/unless}}</fieldset></aside><div class="op-main"><header class="op-header"><div class="op-heading"><p class="op-eyebrow">ONE PIECE RPG · RECONSTRUÇÃO EXPERIMENTAL</p><label class="op-name"><span class="sr-only">Nome</span><input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><p class="op-subtitle">{{#if isShip}}Embarcação{{else if isNPC}}NPC / Inimigo{{else}}Personagem{{/if}} · {{system.identity.combatStyle}}</p></div>{{#unless isShip}}<label>Nível<input type="number" name="system.progression.level" value="{{system.progression.level}}" min="1" max="20"></label>{{/unless}}</header><nav class="op-tabs op-tabs-wide" aria-label="Seções da ficha">{{#each tabs}}<button type="button" data-action="selectTab" data-tab="{{id}}" aria-pressed="{{active}}"><i class="{{icon}}" aria-hidden="true"></i> {{label}}</button>{{/each}}</nav><fieldset {{#unless editable}}disabled{{/unless}} class="op-body"><section aria-label="Detalhes" {{#unless active.details}}hidden{{/unless}}>{{#if isShip}}<article class="op-card"><h3>Embarcação</h3><label>PV atuais<input type="number" name="system.vitality.value" value="{{system.vitality.value}}" min="0"></label><label>PV máximos<input type="number" name="system.vitality.max" value="{{system.vitality.max}}" min="0"></label><label>CR<input type="number" name="system.defense.rating" value="{{system.defense.rating}}" ></label><label>Tamanho<input type="text" name="system.structure.size" value="{{system.structure.size}}" ></label><label>Deques<input type="number" name="system.structure.decks" value="{{system.structure.decks}}" min="0"></label><label>Cômodos<input type="number" name="system.structure.rooms" value="{{system.structure.rooms}}" min="0"></label><label>Tripulantes<input type="number" name="system.crew.current" value="{{system.crew.current}}" min="0"></label><label>Efetivo necessário<input type="number" name="system.crew.required" value="{{system.crew.required}}" min="0"></label><label>Capacidade<input type="number" name="system.crew.capacity" value="{{system.crew.capacity}}" min="0"></label><label>Movimento (m)<input type="number" name="system.movement.distance" value="{{system.movement.distance}}" min="0" step="any"></label><label>Rumo<input type="text" name="system.navigation.heading" value="{{system.navigation.heading}}" ></label><label>Clima<input type="text" name="system.navigation.weather" value="{{system.navigation.weather}}" ></label><label>Diário de navegação<textarea name="system.navigation.notes">{{system.navigation.notes}}</textarea></label></article>{{else}}<div class="op-attributes">{{#each attributes}}<article class="op-attribute"><h3>{{label}}</h3><label><span class="sr-only">Valor de {{label}}</span><input type="number" min="1" name="system.attributes.{{id}}.base" value="{{base}}"></label><strong class="op-modifier">{{modifier}}</strong><button type="button" data-action="rollAttribute" data-attribute="{{id}}">Testar</button><label class="op-checkbox"><input type="checkbox" name="system.attributes.{{id}}.saveProficient" {{#if saveProficient}}checked{{/if}}> Prof. salva</label><button type="button" data-action="rollAttribute" data-attribute="{{id}}" data-save="true">Salvaguarda</button></article>{{/each}}</div><p class="op-hint">Shift: vantagem · Alt: desvantagem · Shift + Alt: normal. Exaustão é incluída no d20.</p><div class="op-two-col"><article class="op-card"><h3>Perícias e passivos</h3><ul class="op-skills">{{#each skills}}<li><input type="checkbox" aria-label="Proficiência em {{label}}" name="system.skills.{{id}}.proficient" {{#if proficient}}checked{{/if}}><button type="button" data-action="rollSkill" data-skill="{{id}}">{{label}}</button><span>{{total}}</span><span class="op-hint">{{passive}}</span></li>{{/each}}</ul></article><article class="op-card"><h3>Identidade e progresso</h3><label>Estilo de combate<input type="text" name="system.identity.combatStyle" value="{{system.identity.combatStyle}}" ></label><label>Profissão<input type="text" name="system.identity.profession" value="{{system.identity.profession}}" ></label><label>Experiência<input type="number" name="system.experience" value="{{system.experience}}" min="0"></label><label>Deslocamento base (m)<input type="number" name="system.movement.distance" value="{{system.movement.distance}}" min="0" step="any"></label><p>Peso {{system.inventoryWeight}} kg · Carga {{system.carryingCapacity}} kg</p><label>Tipo do Dado de Vida<input type="number" name="system.hitDice.faces" value="{{system.hitDice.faces}}" min="6" max="12" step="2"></label><label>DV disponíveis<input type="number" name="system.hitDice.available" value="{{system.hitDice.available}}" min="0"></label><label>DV máximos<input type="number" name="system.hitDice.max" value="{{system.hitDice.max}}" min="0"></label><div class="op-buttons"><button type="button" data-action="startShortRest">Iniciar descanso curto</button><button type="button" data-action="finishShortRest">Concluir descanso curto</button><button type="button" data-action="hitDie">Gastar DV</button><button type="button" data-action="startRest">Iniciar descanso longo</button><button type="button" data-action="finishRest">Concluir descanso longo</button></div></article></div>{{#if isNPC}}<article class="op-card"><h3>Bloco de criatura</h3><label>ND (aceita fração)<input type="text" name="system.challenge" value="{{system.challenge}}" ></label><label>XP concedido<input type="number" name="system.rewardXP" value="{{system.rewardXP}}" min="0"></label><label>Proficiência da fonte<input type="number" name="system.proficiencyOverride" value="{{system.proficiencyOverride}}" min="0"></label><label>CD da fonte<input type="number" name="system.saveDifficulty" value="{{system.saveDifficulty}}" ></label><label>Lendárias restantes<input type="number" name="system.legendaryActions.value" value="{{system.legendaryActions.value}}" min="0"></label><label>Máximo lendário<input type="number" name="system.legendaryActions.max" value="{{system.legendaryActions.max}}" min="0"></label><label>Sentidos<input type="text" name="system.senses" value="{{system.senses}}" ></label><p class="op-hint">Valores do bloco são preservados; não inferir ND por nível de personagem.</p></article>{{/if}}{{/if}}</section><section aria-label="Inventário" {{#unless active.inventory}}hidden{{/unless}}>{{#unless isShip}}<article class="op-card"><h3>Dinheiro</h3><label>฿<input type="number" name="system.currency" value="{{system.currency}}" min="0"></label></article>{{/unless}}{{> "systems/oprpg-native/templates/groups.hbs" groups=inventoryGroups}}</section><section aria-label="Características" {{#unless active.features}}hidden{{/unless}}>{{> "systems/oprpg-native/templates/groups.hbs" groups=featureGroups}}</section><section aria-label="Técnicas" {{#unless active.techniques}}hidden{{/unless}}>{{> "systems/oprpg-native/templates/groups.hbs" groups=techniqueGroups}}</section><section aria-label="Haki e Akuma" {{#unless active.powers}}hidden{{/unless}}><div class="op-two-col"><article class="op-card"><h3>Haki · {{system.haki.stage}}</h3><label class="op-checkbox"><input type="checkbox" name="system.haki.awakened" {{#if system.haki.awakened}}checked{{/if}}> Despertar autorizado</label><label class="op-checkbox"><input type="checkbox" name="system.haki.kingAllowed" {{#if system.haki.kingAllowed}}checked{{/if}}> Haki do Rei autorizado</label><label>PA ociosos<input type="number" name="system.haki.unspent" value="{{system.haki.unspent}}" min="0"></label><label>PA em Armamento<input type="number" name="system.haki.armament" value="{{system.haki.armament}}" min="0"></label><label>PA em Observação<input type="number" name="system.haki.observation" value="{{system.haki.observation}}" min="0"></label><label>PA em Rei<input type="number" name="system.haki.king" value="{{system.haki.king}}" min="0"></label></article><article class="op-card"><h3>Akuma no Mi</h3><label>Fruto<input type="text" name="system.fruit.name" value="{{system.fruit.name}}" ></label><label>Estágio<input type="text" name="system.fruit.stage" value="{{system.fruit.stage}}" ></label><label>Transformações e anotações<textarea name="system.fruit.notes">{{system.fruit.notes}}</textarea></label></article></div>{{> "systems/oprpg-native/templates/groups.hbs" groups=powerGroups}}</section><section aria-label="Treinos e profissões" {{#unless active.training}}hidden{{/unless}}>{{> "systems/oprpg-native/templates/groups.hbs" groups=trainingGroups}}<article class="op-card"><h3>Recursos de características</h3><button type="button" data-action="addResource">Adicionar recurso</button>{{#each system.resources}}<input type="hidden" name="system.resources.{{@index}}.id" value="{{id}}"><div class="op-resource-row"><label>Nome<input name="system.resources.{{@index}}.name" value="{{name}}"></label><label>Atual<input type="number" min="0" name="system.resources.{{@index}}.value" value="{{value}}"></label><label>Máximo<input type="number" min="0" name="system.resources.{{@index}}.max" value="{{max}}"></label><input type="hidden" name="system.resources.{{@index}}.recovery" value="{{recovery}}"><input type="hidden" name="system.resources.{{@index}}.source" value="{{source}}"></div>{{/each}}</article></section><section aria-label="Efeitos" {{#unless active.effects}}hidden{{/unless}}><article class="op-card"><h3>Efeitos nativos</h3>{{#if isGM}}<button type="button" data-action="createEffect">Criar modificador</button>{{/if}}<ul class="op-effects">{{#each effects}}<li><img src="{{img}}" alt=""><span>{{name}} · {{#if disabled}}desativado{{else}}ativo{{/if}} · {{duration}}</span>{{#if @root.isGM}}<button type="button" data-action="editEffect" data-effect-id="{{id}}">Editar</button><button type="button" data-action="toggleEffect" data-effect-id="{{id}}">Alternar</button>{{/if}}</li>{{else}}<li class="op-hint">Nenhum efeito registrado.</li>{{/each}}</ul><p class="op-hint">Use campos e operações do catálogo próprio. Integrações com módulos ficam para depois.</p></article></section><section aria-label="Personalização" {{#unless active.personal}}hidden{{/unless}}><article class="op-card"><h3>Sonhos, caminhos e história</h3><label>Sonho<input type="text" name="system.personal.dream" value="{{system.personal.dream}}" ></label><label>Caminho<input type="text" name="system.personal.path" value="{{system.personal.path}}" ></label><label>Antecedente<input type="text" name="system.personal.background" value="{{system.personal.background}}" ></label><label>Código de honra<input type="text" name="system.personal.honor" value="{{system.personal.honor}}" ></label><label>Personalidade<textarea name="system.personal.personality">{{system.personal.personality}}</textarea></label><label>Anotações<textarea name="system.personal.notes">{{system.personal.notes}}</textarea></label><label>História<textarea name="system.identity.biography">{{system.identity.biography}}</textarea></label></article></section>{{#if showAssistant}}<section aria-label="Criação" {{#unless active.creation}}hidden{{/unless}}><article class="op-card"><h3>Criação de personagem</h3><div class="op-steps"><span>01 · Espécie</span><span>02 · Estilo</span><span>03 · Profissão</span><span>04 · Atributos</span><span>05 · Personalização</span><span>06 · Token</span></div><h2>Criação e conferência</h2><label>Espécie disponível<select data-species-picker><option value="">Escolha uma espécie</option>{{#each species}}<option value="{{id}}">{{name}}{{#if homebrew}} — Homebrew{{/if}}</option>{{/each}}</select></label><button type="button" data-action="applySpecies">Registrar espécie</button>{{#if isGM}}<button type="button" data-action="createSpecies">Criar espécie personalizada</button>{{/if}}<p>{{system.identity.species.name}} · {{system.identity.species.origin}} · v{{system.identity.species.version}}</p><p class="op-traits">{{system.identity.species.traits}}</p><ul class="op-checklist">{{#each checklist}}<li><span>{{#if complete}}✓{{else}}○{{/if}}</span>{{label}}</li>{{/each}}</ul><label class="op-checkbox"><input type="checkbox" name="system.creation.attributesReviewed" {{#if system.creation.attributesReviewed}}checked{{/if}}> Atributos e escolhas conferidos</label><label class="op-checkbox"><input type="checkbox" name="system.creation.resourcesReviewed" {{#if system.creation.resourcesReviewed}}checked{{/if}}> Recursos e conteúdo conferidos</label><p class="op-hint">Os benefícios dependem da fonte e da sua configuração. A aba pode ser desativada sem perder os dados.</p></article></section>{{/if}}</fieldset></div></div>